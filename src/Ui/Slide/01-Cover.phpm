<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\Slide;
use Phem\Attribute\Component;
use Phem\Node;

// Say the title, then introduce yourself in 30 seconds: Yonel Ceruto, Software Architect at
// Vacatia and member of the Symfony Core Team. Then: "Today I want to show you one small
// feature, a like button, and count the wires we need to build it in PHP. At the end, I show you
// a way to cut most of them." Do not name the tech yet.
#[Component]
function Cover(): Node
{
    return (
        <Slide glowX="82%" glowY="45%">
            <div className="absolute top-[100px] left-20 w-[770px]">
                <h1 className="ph-display">Cut the <span className="ph-em">wires</span></h1>
                <p className="mt-6 [font:var(--text-pill-label)]">A component model for Symfony Web apps</p>
            </div>
            <div className="absolute top-[389px] left-20">
                <p className="[font:var(--text-point)] font-bold">Yonel Ceruto</p>
                <p className="mt-2 flex items-center gap-3 [font:var(--text-body)] text-(--text-secondary)">
                    Software Architect at <img src={{ asset('images/vacatia.svg') }} alt="Vacatia" className="h-[38px]" />
                </p>
                <p className="mt-1 [font:var(--text-body)] text-(--text-secondary)">Symfony Core Team</p>
            </div>
            <img
                src={{ asset('images/yonel-ceruto.jpg') }}
                alt="Photo of Yonel Ceruto"
                className="absolute top-[calc(50%-35px)] left-[853px] size-[316px] -translate-y-1/2 rounded-full border-4 border-(--surface)"
            />
            <div className="absolute right-20 bottom-[18px] left-20 flex items-center justify-between">
                <p className="flex items-center gap-2 [font:var(--text-point)]">
                    <img src={{ asset('images/github.svg') }} alt="GitHub" className="size-[25px]" /> @yceruto
                </p>
                <p className="flex items-center gap-4">
                    <span className="ph-eyebrow m-0">Symfonyconf · Warsaw · 2026</span>
                    <img src={{ asset('images/symfony.svg') }} alt="Symfony" className="size-14" />
                </p>
            </div>
        </Slide>
    );
}
