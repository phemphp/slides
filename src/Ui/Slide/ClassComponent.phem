<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function ClassComponent(): Node
{
    $code = <<<'PHP'
        #[Component]
        class LikeButton
        {
            #[Prop] public Post $post;

            #[Transactional]
            public function like(): void 
            {
                ++$this->post->likes;
            }

            public function render(): Node
            {
                return <button onClick={{ like }}>
                    ♥ {{ post.likes }}
                </button>;
            }
        }
        PHP;

    return (
        <CodeSlide>
            <CodeWindow code={{ code }} file="src/Ui/LikeButton.phem" size="sm" />
            <CodeSlide:notes>
                <Annotation step="1" muted>Mark a class</Annotation>
                <Annotation step="2" muted>A prop is a property</Annotation>
                <Annotation step="3" muted>A handler is a method</Annotation>
                <Annotation step="4" muted>The markup uses both</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}
