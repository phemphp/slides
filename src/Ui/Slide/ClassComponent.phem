<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeSlide, CodeWindow};
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function ClassComponent(): Node
{
    $code = <<<'PHP'
        <?phem

        #[Component]
        final class LikePostButton
        {
            #[State] public Post $post;

            public function like(): void {
                ++$this->post->likes;
            }

            public function render(): Node {
                return <button onClick={{ like }}>
                    ♥ {{ post.likes }}
                </button>;
            }
        }
        PHP;

    return (
        <CodeSlide steps={{ 5 }}>
            <CodeSlide:title>A component is a <span className="ph-em">PHP class</span> and <span className="ph-em">Twig markup</span></CodeSlide:title>
            <CodeWindow code={{ code }} file="src/Ui/LikePostButton.phem" size="sm" reveal steps={{ {1: '5', 3: '1', 6: '2', 8: '3', 12: '4'} }} stepFocus={{ {1: [3, 4], 2: [6], 3: [8, 9, 10], 4: [12, 13, 14, 15, 16], 5: [1]} }} />
            <CodeSlide:notes>
                <Annotation step="1" reveal>Mark a class</Annotation>
                <Annotation step="2" reveal>State is a property</Annotation>
                <Annotation step="3" reveal>A handler is a method</Annotation>
                <Annotation step="4" reveal>The markup uses both</Annotation>
                <Annotation step="5" reveal>A new file type: .phem</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}
