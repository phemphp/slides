<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function ClassComponent(): Node
{
    $code = <<<'PHP'
        <?phem

        #[Component]
        final class PostCard
        {
            #[Prop] public Post $post;

            public function like(): void {
                $this->post->liked = !$this->post->liked;
            }

            public function render(): Node {
                return <article>
                    <h2>{{ post.title }}</h2>
                    <LikeButton liked={{ post.liked }} onClick={{ like }} />
                </article>;
            }
        }
        PHP;

    return (
        <CodeSlide steps={{ 4 }}>
            <CodeSlide:title>A component is a <span className="ph-em">PHP class</span> and <span className="ph-em">Twig markup</span></CodeSlide:title>
            <CodeWindow code={{ code }} file="src/Ui/PostCard.phem" size="sm" reveal dim={{ false }} steps={{ {3: '1', 6: '2', 8: '3', 12: '4'} }} stepFocus={{ {1: [3, 4], 2: [6], 3: [8, 9, 10], 4: [12, 13, 14, 15, 16, 17]} }} />
            <CodeSlide:notes>
                <Annotation step="1" reveal>Mark a class</Annotation>
                <Annotation step="2" reveal>A prop is a property</Annotation>
                <Annotation step="3" reveal>A handler is a method</Annotation>
                <Annotation step="4" reveal>The markup uses both</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}
