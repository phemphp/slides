<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, Chip, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function FunctionComponent(): Node
{
    $code = <<<'PHP'
        <?phem

        namespace App\Ui;

        use Phem\{Attribute\Component, Node};

        #[Component]
        function LikeButton(bool $liked): Node
        {
            return <button class="btn">
                {{ liked ? '♥' : '♡' }}
            </button>;
        }
        PHP;

    $usage = '<LikeButton liked={{ true }} />';

    return (
        <CodeSlide>
            <CodeSlide:title>A component is a <span className="ph-em">PHP function</span> and <span className="ph-em">Twig markup</span></CodeSlide:title>
            <div className="grid gap-6">
                <CodeWindow code={{ code }} file="src/Ui/LikeButton.phem" size="sm" steps={{ {1: '1', 7: '2', 8: '3', 10: '4'} }} muted />
                <div className="flex items-center gap-4">
                    <span className="ph-eyebrow m-0">Use it</span>
                    <Chip mono>{{ usage }}</Chip>
                    <span className="ph-eyebrow m-0">Render it</span>
                    <button type="button" className="ph-button ph-button-primary ph-like" aria-label="Liked">♥</button>
                </div>
            </div>
            <CodeSlide:notes>
                <Annotation step="1" muted>A new file type: .phem</Annotation>
                <Annotation step="2" muted>Mark a function</Annotation>
                <Annotation step="3" muted>Parameters are props</Annotation>
                <Annotation step="4" muted>It returns markup</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}
