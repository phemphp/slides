<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, Chip, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function FunctionComponent(): Node
{
    $code = <<<'PHP'
        <?phem

        namespace App\Ui;

        use Phem\Attribute\Component;
        use Phem\{Html, Node};

        #[Component]
        function Badge(Html $children): Node
        {
            return <span className="border-ring rounded-full px-3 py-1">
                {{ children }}
            </span>;
        }
        PHP;

    $usage = '<Badge>Success</Badge>';

    return (
        <CodeSlide>
            <div className="grid gap-6">
                <CodeWindow code={{ code }} file="src/Ui/Badge.phem" size="sm" focus={{ [8] }} dim={{ false }} />
                <div className="flex items-center gap-4">
                    <span className="ph-eyebrow m-0">Use it</span>
                    <Chip mono>{{ usage }}</Chip>
                    <span className="ph-eyebrow m-0">Render it</span>
                    <button type="button" className="ph-button ph-button-primary ph-like" aria-label="Liked">Success</button>
                </div>
            </div>
            <CodeSlide.notes>
                <Annotation step="1" muted>A new file type: .phem</Annotation>
                <Annotation step="2" muted>Mark a function</Annotation>
                <Annotation step="3" muted>Parameters are props</Annotation>
                <Annotation step="4" muted>It returns markup</Annotation>
            </CodeSlide.notes>
            <CodeSlide.speakerNotes>
                <ul>
                    <li>The smallest component: a function</li>
                    <li>This is PHP & Twig markup</li>
                    <li>Parameters are props</li>
                    <li>Examples: badge, label, card, etc.</li>
                    <li>phemc</li>
                </ul>
            </CodeSlide.speakerNotes>
        </CodeSlide>
    );
}
