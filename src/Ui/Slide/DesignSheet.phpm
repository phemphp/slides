<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, Arrow, BulletSlide, Button, Callout, Chip, CodeSlide, CodeWindow, ComparisonSlide, FlowNode, FlowSlide, GlassPill, IconOrb, ListItem, Sandbox, SectionSlide, Slide, SlideHeading, SplitSlide, StepMarker, Terminal, TitleSlide};
use Phem\Attribute\Component;
use Phem\{Html, Node};

// The sheet of the design system: one tile for each component, to check their look on the
// projector. The samples come from the design system.
#[Component]
function DesignSheet(): Node
{
    $myButton = <<<'PHP'
        #[Component]
        function MyButton(
            int $count,
            Closure $onClick,
        ): Node {
            return (
                <button onClick={{ onClick }}>
                    Clicked {{ count }} times
                </button>
            );
        }
        PHP;

    $myButtonJsx = <<<'JSX'
        function MyButton({
            count,
            onClick,
        }) {
            return (
                <button onClick={onClick}>
                    Clicked {count} times
                </button>
            );
        }
        JSX;

    $counters = <<<'PHP'
        #[Page('/counters')]
        final class Counters
        {
            public int $count = 0;
            #[State] public int $count = 0;

            public function handleClick(): void
            {
                ++$this->count;
            }
        }
        PHP;

    $addScientist = <<<'PHP'
        #[Component]
        final class AddScientist
        {
            public function __construct(
                private readonly ScientistRepository $scientists,
            ) {
            }

            public function add(Event $e): void
            {
                $this->scientists->add(new Scientist(
                    $e->form['name'],
                ));
            }
        }
        PHP;

    $terminal = [
        ['cmd', 'make check'],
        ['dim', 'phemc check src/'],
        ['ok', '24 files, 0 errors'],
        ['cmd', 'phemc build src/Pages/Counters.phpm'],
        ['err', 'error: unknown prop `cout` on <MyButton>'],
        ['cmd', 'make test'],
        ['ok', 'OK (212 tests, 640 assertions)'],
    ];

    return (
        <Slide className="ph-sheet" glowX="50%" glowY="0%">
            <SlideHeading eyebrow="Phem design system" className="text-[40px]">All the <span className="ph-em">components</span></SlideHeading>
            <div className="ph-sheet-grid">
                <Tile name="IconOrb" group="Elements">
                    <Stage>
                        <div className="ph-row gap-10">
                            <IconOrb icon="home" size="lg" active />
                            <IconOrb icon="server" />
                            <IconOrb icon="layers" size="sm" />
                            <IconOrb number="1" size="sm" />
                        </div>
                    </Stage>
                </Tile>
                <Tile name="GlassPill" group="Elements">
                    <Stage>
                        <GlassPill label="Home" icon="home" active />
                        <div className="ph-row gap-4">
                            <GlassPill label="Events" icon="bolt" small />
                            <GlassPill label="Streams" icon="broadcast" small />
                        </div>
                    </Stage>
                </Tile>
                <Tile name="Button" group="Elements">
                    <Stage>
                        <div className="ph-row gap-4">
                            <Button primary>Learn Phem</Button>
                            <Button icon="bolt">Run handler</Button>
                        </div>
                        <div className="ph-row gap-4">
                            <Button pressed click>Clicked 3 times</Button>
                            <Arrow label="onClick" tone="accent" style="min-width: 120px" />
                            <Chip mono>handleClick()</Chip>
                        </div>
                    </Stage>
                </Tile>
                <Tile name="Chip" group="Elements">
                    <Stage>
                        <div className="ph-row gap-3">
                            <Chip dot="tok-attribute">PHP 8.5</Chip>
                            <Chip dot="metal-light">Symfony</Chip>
                            <Chip dot="tok-tag">Bundle</Chip>
                            <Chip dot="success">Twig</Chip>
                        </div>
                        <div className="ph-row gap-3">
                            <Chip dot="accent-cool">Turbo</Chip>
                            <Chip dot="accent">Stimulus</Chip>
                            <Chip dot="tok-keyword">Mercure</Chip>
                        </div>
                        <div className="ph-row gap-3">
                            <Chip mono>#[State]</Chip>
                            <Chip mono>.phpm</Chip>
                            <Chip mono>POST /counters</Chip>
                        </div>
                    </Stage>
                </Tile>
                <Tile name="StepMarker" group="Elements">
                    <Stage width={{ 480 }}>
                        <div className="ph-row gap-5">
                            <StepMarker>1</StepMarker>
                            <StepMarker>2</StepMarker>
                            <StepMarker tone="cool">3</StepMarker>
                            <StepMarker tone="muted">4</StepMarker>
                        </div>
                        <div className="ph-row gap-5">
                            <StepMarker small>1</StepMarker>
                            <StepMarker small>2</StepMarker>
                            <StepMarker small tone="cool">3</StepMarker>
                        </div>
                    </Stage>
                </Tile>
                <Tile name="Arrow" group="Elements">
                    <Stage width={{ 800 }}>
                        <div className="ph-row items-stretch gap-12">
                            <div className="grid gap-8">
                                <Arrow label="POST /counters" />
                                <Arrow label="Turbo Streams" tone="accent" back />
                                <Arrow label="Mercure update" tone="cool" dashed />
                            </div>
                            <Arrow label="render()" down />
                            <Arrow curve="M10 130 C 60 10, 180 0, 240 60" tone="accent" width={{ 250 }} height={{ 140 }} />
                        </div>
                    </Stage>
                </Tile>

                <Tile name="Annotation" group="Elements">
                    <Stage>
                        <Annotation step="1">
                            A function with <span className="ph-code-inline">#[Component]</span> is a component.
                            <Annotation:detail>It returns markup, not a string.</Annotation:detail>
                        </Annotation>
                        <Annotation step="2">
                            The handler is PHP.
                            <Annotation:detail>A click sends an event to the server.</Annotation:detail>
                        </Annotation>
                    </Stage>
                </Tile>
                <Tile name="Callout" group="Elements">
                    <Stage width={{ 960 }}>
                        <Callout title="Where does the handler run?" icon="server" active>
                            On the server. The browser sends the event and the signed state; PHP runs the handler and Turbo morphs only what changed.
                        </Callout>
                        <Callout title="Compute first, then return" icon="bolt" warning>
                            Do not put PHP code in markup. Compute the values before the return, then print them with Twig.
                        </Callout>
                    </Stage>
                </Tile>
                <Tile name="CodeWindow" group="Code">
                    <Stage width={{ 960 }}>
                        <CodeWindow
                            code={{ counters }}
                            file="Counters.phpm"
                            tabs={{ ['Document.phpm'] }}
                            removed={{ [4] }}
                            added={{ [5] }}
                            tags={{ {5: 'STATE'} }}
                            steps={{ {9: '1'} }}
                            className="w-full"
                        />
                    </Stage>
                </Tile>
                <Tile name="Terminal" group="Code">
                    <Stage width={{ 800 }}>
                        <Terminal title="phem — zsh" lines={{ terminal }} className="w-full" />
                    </Stage>
                </Tile>
                <Tile name="Sandbox" group="Code">
                    <Stage width={{ 1280 }}>
                        <Sandbox url="localhost:8080/counters" className="w-full">
                            <CodeWindow code={{ myButton }} file="MyButton.phpm" size="sm" focus={{ [7, 8] }} steps={{ {7: '1'} }} />
                            <Sandbox:preview>
                                <h3>Counters that update together</h3>
                                <Button>Clicked 3 times</Button>
                                <Button pressed click>Clicked 3 times</Button>
                                <Annotation step="1">
                                    A click runs the PHP handler.
                                    <Annotation:detail>Turbo morphs both buttons.</Annotation:detail>
                                </Annotation>
                            </Sandbox:preview>
                            <Sandbox:status>
                                <Chip mono>POST /counters</Chip>
                                <Chip mono>200 · 38 ms</Chip>
                                <Chip mono>morph ×2</Chip>
                            </Sandbox:status>
                        </Sandbox>
                    </Stage>
                </Tile>
                <Tile name="TitleSlide" group="Slides">
                    <TitleSlide title="Phem" eyebrow="Symfony Live · 2026" footer="Yonel Ceruto" number="01">
                        React-style components in PHP 8.5 and Twig. <span className="ph-em">No JavaScript to write.</span>
                    </TitleSlide>
                </Tile>

                <Tile name="SectionSlide" group="Slides">
                    <SectionSlide label="Events" icon="bolt" part="Part 2 of 4" footer="Phem · PHP + Twig" number="12">
                        A click in the browser runs a method on the server.
                    </SectionSlide>
                </Tile>
                <Tile name="BulletSlide" group="Slides">
                    <BulletSlide eyebrow="Agenda" footer="Phem · PHP + Twig" number="03">
                        <BulletSlide:title>How Phem works</BulletSlide:title>
                        <ListItem icon="layers" title="Components" detail=".phpm files: PHP code and Twig markup" />
                        <ListItem icon="bolt" title="Events" detail="Handlers run on the server" active />
                        <ListItem icon="server" title="State" detail="Signed, kept in the page" />
                        <ListItem icon="broadcast" title="Streams" detail="Mercure updates other tabs" />
                    </BulletSlide>
                </Tile>
                <Tile name="CodeSlide" group="Slides">
                    <CodeSlide eyebrow="Components" footer="Phem · PHP + Twig" number="08">
                        <CodeSlide:title>A component is a <span className="ph-em">PHP function</span></CodeSlide:title>
                        <CodeWindow code={{ myButton }} file="MyButton.phpm" focus={{ [3, 4, 8] }} steps={{ {3: '1', 8: '2'} }} />
                        <CodeSlide:notes>
                            <Annotation step="1">Typed props are the parameters.</Annotation>
                            <Annotation step="2">Twig prints the values.</Annotation>
                        </CodeSlide:notes>
                    </CodeSlide>
                </Tile>
                <Tile name="SplitSlide" group="Slides">
                    <SplitSlide eyebrow="Services" footer="Phem · PHP + Twig" number="15">
                        <SplitSlide:title>Components are <span className="ph-em">services</span></SplitSlide:title>
                        <ListItem step="1" title="Autowired constructor" detail="Inject a repository" />
                        <ListItem step="2" title="One transaction" detail="Phem flushes on return" />
                        <SplitSlide:code>
                            <CodeWindow code={{ addScientist }} file="AddScientist.phpm" size="sm" focus={{ [5, 11, 12, 13] }} steps={{ {5: '1', 11: '2'} }} />
                        </SplitSlide:code>
                    </SplitSlide>
                </Tile>
                <Tile name="ComparisonSlide" group="Slides">
                    <ComparisonSlide eyebrow="React vs Phem" beforeLabel="React · JSX" afterLabel="Phem · .phpm" footer="Phem · PHP + Twig" number="09">
                        <ComparisonSlide:title>Same idea, <span className="ph-em">PHP syntax</span></ComparisonSlide:title>
                        <ComparisonSlide:before>
                            <CodeWindow code={{ myButtonJsx }} file="MyButton.jsx" size="sm" />
                        </ComparisonSlide:before>
                        <ComparisonSlide:after>
                            <CodeWindow code={{ myButton }} file="MyButton.phpm" size="sm" focus={{ [1, 3, 4, 7, 8] }} />
                        </ComparisonSlide:after>
                    </ComparisonSlide>
                </Tile>
                <Tile name="FlowSlide" group="Slides">
                    <FlowSlide eyebrow="Events" footer="Phem · PHP + Twig" number="13">
                        <FlowSlide:title>What happens on a <span className="ph-em">click</span></FlowSlide:title>
                        <FlowNode icon="browser" label="Browser" caption="Stimulus sends the event and the signed state" />
                        <Arrow label="POST /counters" tone="accent" className="flex-1" />
                        <FlowNode icon="server" label="PHP handler" caption="handleClick() changes the state" active />
                        <Arrow label="render()" className="flex-1" />
                        <FlowNode icon="layers" label="Twig" caption="Renders only the changed components" />
                        <FlowSlide:back>
                            <Arrow label="Turbo Streams · morph" tone="cool" back style="width: 760px" />
                        </FlowSlide:back>
                    </FlowSlide>
                </Tile>
            </div>
        </Slide>
    );
}

// A tile of the sheet: the component and its name.
#[Component]
function Tile(string $name, string $group, Html $children): Node
{
    return (
        <figure className="ph-tile">
            <div className="ph-tile-view">{{ children }}</div>
            <figcaption className="ph-tile-name">{{ name }} <span className="ph-tile-group">· {{ group }}</span></figcaption>
        </figure>
    );
}

// A 16:9 stage of the given width for one element, scaled to the tile.
#[Component]
function Stage(Html $children, int $width = 640): Node
{
    $style = sprintf('--frame-w: %dpx; --frame-h: %dpx;', $width, $width * 9 / 16);

    return (
        <div className="ph-frame" style={{ style }}>
            <div className="ph-frame-content ph-frame-stage">{{ children }}</div>
        </div>
    );
}
