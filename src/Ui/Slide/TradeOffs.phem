<?phem

namespace App\Ui\Slide;

use App\Ui\Component\SlideHeading;
use App\Ui\Layout\Slide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function TradeOffs(): Node
{
    $tradeOffs = [
        ['title' => 'Each event is a round trip', 'body' => 'Browser-only logic stays in a Stimulus controller.'],
        ['title' => 'State is JSON', 'body' => 'Closures, objects and services are not state.'],
        ['title' => 'The server renders each change', 'body' => 'Less JavaScript in the browser, more work for your servers.'],
        ['title' => '.phem needs a build step', 'body' => 'PHPStan and your tests use the compiled PHP.'],
    ];

    return (
        <Slide glowX="30%" glowY="50%">
            <SlideHeading>The <span className="ph-em">trade-offs</span></SlideHeading>
            <div className="mt-12 grid grid-cols-2 gap-8">
                {% for item in tradeOffs %}
                    <div key={{ item.title }} className="ph-card">
                        <p className="ph-callout-title">{{ item.title }}</p>
                        <p className="ph-callout-body">{{ item.body }}</p>
                    </div>
                {% endfor %}
            </div>
            <Slide.speakerNotes>
                <ul>
                    <li>Four costs</li>
                    <li>Stimulus for browser-only logic</li>
                    <li>Back to the button: three files to one</li>
                </ul>
            </Slide.speakerNotes>
        </Slide>
    );
}
