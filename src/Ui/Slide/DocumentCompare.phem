<?phem

namespace App\Ui\Slide;

use App\Ui\Component\CodeWindow;
use App\Ui\Layout\ComparisonSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function DocumentCompare(): Node
{
    $before = <<<'TWIG'
        <html>
            <head>
                <title>{% block title %}{% endblock %}</title>
                {{ importmap('app') }}
            </head>
            <body>
                {% block body %}{% endblock %}
            </body>
        </html>
        TWIG;

    $after = <<<'PHP'
        use Phem\Root;

        #[Component]
        function Document(string $title, Html $children): Node
        {
            return <html>
                <head>
                    <title>{{ title }}</title>
                    {{ importmap('app') }}
                </head>
                <body>
                    <Root>{{ children }}</Root>
                </body>
            </html>;
        }
        PHP;

    return (
        <ComparisonSlide beforeLabel="Before" afterLabel="After">
            <ComparisonSlide.before>
                <CodeWindow code={{ before }} file="templates/base.html.twig" size="xs" numbers={{ false }} />
            </ComparisonSlide.before>
            <ComparisonSlide.after>
                <CodeWindow code={{ after }} file="src/Ui/Document.phem" size="xs" numbers={{ false }} />
            </ComparisonSlide.after>
            <ComparisonSlide.speakerNotes>
                <ul>
                    <li>Blocks become props and children</li>
                    <li>Root: the part that Phem updates</li>
                </ul>
            </ComparisonSlide.speakerNotes>
        </ComparisonSlide>
    );
}
