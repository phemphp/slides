<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{BulletSlide, JoinQr, ListItem, Slide, SlideHeading, TitleSlide};
use Phem\Node;

// The slides of the presentation, in their order. A slide is markup: it renders only when it is
// the current slide. A dynamic slide is a component with its own handlers.
final class Slides
{
    /**
     * @return list<Node>
     */
    public function all(): array
    {
        return [
            // To check the look of the design system. Remove it before the talk.
            <DesignSheet />,

            <TitleSlide title="Phem" eyebrow="Phem, live">
                Components for Symfony. <span className="ph-em">A slide deck made with Phem, live.</span>
            </TitleSlide>,

            <Slide glowX="72%" glowY="50%" className="flex items-center justify-between">
                <div>
                    <SlideHeading eyebrow="Phem, live">Join on your <span className="ph-em">phone</span></SlideHeading>
                    <p className="ph-lead max-w-[520px]">Open the link or scan the code. Your screen follows the slides.</p>
                </div>
                <JoinQr />
            </Slide>,

            <BulletSlide eyebrow="Phem, live">
                <BulletSlide:title>How this <span className="ph-em">deck</span> works</BulletSlide:title>
                <ListItem icon="layers" title="Each slide is Phem markup." />
                <ListItem icon="cursor" title="The speaker moves the slides with the keyboard." />
                <ListItem icon="broadcast" title="Your phone follows with Mercure, in real time." active />
            </BulletSlide>,

            <Slide glowX="50%" glowY="50%" className="flex items-center justify-center">
                <h2 className="ph-display">Thank you</h2>
            </Slide>,
        ];
    }
}
