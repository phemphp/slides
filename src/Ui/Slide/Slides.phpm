<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{JoinQr, Slide, SlideHeading};
use Phem\Node;

// The slides of the presentation, in their order. A slide is markup: it renders only when it is
// the current slide. A dynamic slide is a component with its own handlers. The speaker notes are
// the comments of the slide components.
final class Slides
{
    /**
     * @return list<Node>
     */
    public function all(): array
    {
        return [
            // Who I am and what this talk is about.
            <Cover />,

            // One like button, built the usual ways, and the wires it needs.
            <Example />,
            <JsonApi />,
            <HtmlOverTheWire />,
            <TwoFiles />,
            <Wires />,
            <Question />,

            // The reveal: one PHP class holds the state, the actions and the markup.
            <Reveal />,
            <FunctionComponent />,
            <ClassComponent />,
            <Action />,
            <Services />,
            <TwigCompare />,

            // How it works: compile to Twig, then events over HTTP.
            <Compile />,
            <EventFlow />,

            // What changes for you, the limits, a live demo and the recap.
            <WiresGone />,
            <ReactMap />,
            <TradeOffs />,
            <Demo />,
            <Thanks />,

            // Extra slides, for reference.
            <Slide glowX="72%" glowY="50%" className="flex items-center justify-between">
                <div>
                    <SlideHeading eyebrow="Phem, live">Join on your <span className="ph-em">phone</span></SlideHeading>
                    <p className="ph-lead max-w-[520px]">Open the link or scan the code. Your screen follows the slides.</p>
                </div>
                <JoinQr />
            </Slide>,
            <DesignSheet />,
        ];
    }
}
