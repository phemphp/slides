<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, Arrow, CodeWindow, FlowNode, ListItem, Slide, SlideHeading, StepMarker};
use Phem\Attribute\Component;
use Phem\Node;

// phemc is a compiler written in Rust. It finds the markup literals in the PHP code, checks them
// (closed tags, one root, known components and props), and writes two things: PHP where each
// literal becomes new \Phem\Element('PostPage.0.twig', [...]), and one Twig template for each
// literal. Show the generated template: the numbers match the previous slide. The parent is an
// embed, the slot is a block, the child is a component tag. Then bin/console phem:warmup
// compiles the Twig cache at build time.
#[Component]
function Compile(): Node
{
    $code = <<<'TWIG'
        {% component embed 'App\\Components\\Document' %}
            {% block title %}My post{% endblock %}
            {% block children %}
                <h1>My post</h1>
                {% component 'App\\Components\\LikeButton' %}
            {% endblock %}
        {% endcomponent %}
        TWIG;

    return (
        <Slide glowX="36%" glowY="58%" footer="At runtime, nothing parses .phpm or .twig">
            <SlideHeading eyebrow="How it works · compile time">It compiles to the <span className="ph-em">Twig you know</span></SlideHeading>
            <div className="mt-12 grid grid-cols-[1fr_340px] items-center gap-12">
                <CodeWindow code={{ code }} file="templates/Pages/PostPage.0.twig" size="sm" focus={{ [1, 2, 5] }} steps={{ {1: '1', 2: '2', 5: '3'} }}>
                    <CodeWindow:meta><span className="ph-eyebrow m-0">Generated</span></CodeWindow:meta>
                </CodeWindow>
                <ul className="ph-list">
                    <ListItem icon="code" title=".phpm" detail="your source" />
                    <ListItem icon="wrench" title="phemc" detail="checks, then writes" active />
                    <ListItem icon="layers" title="PHP + Twig" detail="one per literal" />
                    <ListItem icon="bolt" title="Twig cache" detail="built before deploy" />
                </ul>
            </div>
        </Slide>
    );
}

// 1: the phem Stimulus controller on the root element sends a POST to the page URL: the handler
// name, the event, and the signature of the state. 2: the server keeps no session. The state
// lives in the browser as signed JSON (an HMAC with the app secret), and a cache pool keeps it by
// signature, so the event sends only the signature. The server renders only the components on
// the path to the handler, restores their state, and runs toggle() in a Doctrine transaction.
// 3: it renders only the components that can change, compares their HTML with hashes, and
// answers with a Turbo Stream morph for each one that changed, plus the changed state entries
// and the new signature. 4: Turbo morphs them in place.
#[Component]
function EventFlow(): Node
{
    return (
        <Slide glowX="80%" glowY="38%" footer="No session on the server · the browser keeps the signed state">
            <SlideHeading eyebrow="How it works · an event">What happens when you <span className="ph-em">click Like</span></SlideHeading>
            <div className="mt-12 grid grid-cols-[280px_1fr_280px] items-start gap-6">
                <div className="flex flex-col items-center gap-6">
                    <FlowNode icon="browser" label="Browser" />
                    <Annotation step="4">Morphs only what changed.</Annotation>
                </div>
                <div className="grid gap-10 pt-12">
                    <div className="flex items-center gap-3">
                        <StepMarker small>1</StepMarker>
                        <Arrow label="POST /posts/42 {signature, handler}" tone="accent" className="flex-1" />
                    </div>
                    <div className="flex items-center gap-3">
                        <StepMarker small tone="cool">3</StepMarker>
                        <Arrow label="Turbo Streams + changed state" tone="cool" back className="flex-1" />
                    </div>
                </div>
                <div className="flex flex-col items-center gap-6">
                    <FlowNode icon="server" label="Server" active />
                    <Annotation step="2">Restores the state and runs toggle().</Annotation>
                </div>
            </div>
        </Slide>
    );
}
