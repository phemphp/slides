<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{Chip, Slide};
use Phem\Attribute\Component;
use Phem\Node;

// Say your own story of the name here. One sentence: a .phpm file is a PHP file with markup
// literals, the way a .jsx file is JavaScript with JSX. A compiler written in Rust (phemc) turns
// it into plain PHP and Twig. A Symfony bundle runs it. Turbo and Stimulus carry the events. Now
// the same like button.
#[Component]
function Reveal(): Node
{
    return (
        <Slide glowX="28%" glowY="46%" className="grid grid-cols-[340px_1fr] items-center gap-20">
            <span className="ph-orb is-active" style="--size: 340px; --ring: 24px;">
                <span className="ph-orb-ring"></span>
                <span className="ph-orb-disc"></span>
                <img src={{ asset('images/phem-logo-metal.svg') }} alt="The Phem logo in light brushed metal: an elephant with a sprout" className="relative w-[120px]" />
            </span>
            <div>
                <p className="ph-eyebrow">Meet</p>
                <h1 className="ph-display">Phem</h1>
                <p className="ph-lead">The React component model for Symfony.</p>
                <div className="mt-10 flex flex-wrap gap-3">
                    <Chip mono>Symfony</Chip>
                    <Chip mono>Bundle</Chip>
                    <Chip mono>UI</Chip>
                    <Chip mono>Developer Experience</Chip>
                </div>
            </div>
        </Slide>
    );
}
