<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function PageComponent(): Node
{
    $code = <<<'PHP'
        use App\Entity\Post;
        use Phem\Attribute\{Page, Path};

        #[Page('/posts/{id:post}')]
        class PostPage
        {
            #[Path] public Post $post;

            public function render(): Node
            {
                return <Document title={{ post.title }}>
                    <Article title={{ post.title }}>
                        <p>{{ post.content }}</p>
                        <LikeButton post={{ post }} />
                    </Article>
                </Document>;
            }
        }
        PHP;

    return (
        <CodeSlide>
            <CodeWindow code={{ code }} file="src/Ui/PostPage.phem" size="sm" startNumber={{ 5 }} />
            <CodeSlide.notes>
                <Annotation step="1" muted>A page is a route</Annotation>
                <Annotation step="2" muted>The route value finds the Post</Annotation>
                <Annotation step="3" muted>The page uses the LikeButton</Annotation>
            </CodeSlide.notes>
            <CodeSlide.speakerNotes>
                <ul>
                    <li>The Page attribute is the route</li>
                    <li>The id finds the Post</li>
                    <li>Where do the services come from?</li>
                </ul>
            </CodeSlide.speakerNotes>
        </CodeSlide>
    );
}
