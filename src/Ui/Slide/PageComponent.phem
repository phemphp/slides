<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function PageComponent(): Node
{
    $code = <<<'PHP'
        <?phem

        #[Page('/posts/{id:post}')]
        final class PostPage
        {
            #[Path] public Post $post;

            public function render(): Node {
                return <Document title={{ post.title }}>
                    <PostCard post={{ post }} />
                </Document>;
            }
        }
        PHP;

    return (
        <CodeSlide steps={{ 3 }}>
            <CodeSlide:title>A page is a <span className="ph-em">component</span> with a <span className="ph-em">route</span></CodeSlide:title>
            <CodeWindow code={{ code }} file="src/Ui/PostPage.phem" size="sm" reveal dim={{ false }} steps={{ {3: '1', 6: '2', 10: '3'} }} stepFocus={{ {1: [3, 4], 2: [6], 3: [10]} }} />
            <CodeSlide:notes>
                <Annotation step="1" reveal>A page is a route</Annotation>
                <Annotation step="2" reveal>The route value finds the Post</Annotation>
                <Annotation step="3" reveal>The page uses the PostCard</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}
