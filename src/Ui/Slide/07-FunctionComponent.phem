<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, Chip, CodeSlide, CodeWindow};
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function FunctionComponent(): Node
{
    $code = <<<'PHP'
        <?phem

        #[Component]
        function LikeButton(bool $liked = false): Node
        {
            return (
                <button>
                    {{ liked ? '♥ Liked' : '♡ Like' }}
                </button>
            );
        }
        PHP;

    $usage = '<LikeButton liked={{ true }} />';

    return (
        <CodeSlide>
            <CodeSlide:title>A component is a <span className="ph-em">PHP function</span></CodeSlide:title>
            <div className="grid gap-6">
                <CodeWindow code={{ code }} file="src/Ui/LikeButton.phem" size="sm" focus={{ [1, 3, 4, 7, 8, 9] }} steps={{ {1: '1', 3: '2', 4: '3', 7: '4'} }} />
                <div className="flex items-center gap-4">
                    <span className="ph-eyebrow m-0">Use it</span>
                    <Chip mono>{{ usage }}</Chip>
                </div>
            </div>
            <CodeSlide:notes>
                <Annotation step="1">A new file type: .phem</Annotation>
                <Annotation step="2">Mark a function</Annotation>
                <Annotation step="3">Parameters are props</Annotation>
                <Annotation step="4">It returns markup</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}
