<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{Arrow, Button, Callout, Chip, CodeWindow, FlowNode, GlassPill, IconOrb, ListItem, Slide, SlideHeading};
use Phem\Attribute\Component;
use Phem\{Html, Node};

// This is the only example in the talk: one like button under a post. Three needs: click it
// (the heart fills), save it (the server stores the like), show it (the button shows the new
// state). It is small on purpose: one piece of state, one action, one piece of markup. Ask the
// room: how would you build this today? Keep the answer for the next slides.
#[Component]
function Example(): Node
{
    return (
        <Slide glowX="30%" glowY="60%">
            <SlideHeading>A blog post with a <span className="ph-em">LikeButton</span></SlideHeading>
            <div className="mt-[77px] grid grid-cols-[653px_1fr] items-start gap-12">
                <div className="ph-preview overflow-hidden rounded-(--radius-lg) border border-(--edge)">
                    <div className="ph-preview-bar">
                        <span className="ph-url">localhost/posts/42</span>
                        <span className="ph-live">Live</span>
                    </div>
                    <div className="ph-preview-body">
                        <p className="ph-eyebrow m-0">Blog · 22 October</p>
                        <h3>Hello, components</h3>
                        <p className="m-0 text-[20px] leading-[1.4] text-(--text-secondary)">A short post with one button under it. You click it, the heart fills, and the server saves your like.</p>
                        <Button primary>♡ Like</Button>
                    </div>
                </div>
                <ul className="ph-list">
                    <ListItem number="1" title="Click it" detail="The heart fills." active />
                    <ListItem number="2" title="Save it" detail="The server stores the like." />
                    <ListItem number="3" title="Show it" detail="The button shows the new state." />
                </ul>
            </div>
        </Slide>
    );
}

// The most common answer today. The UI is a JavaScript app in the browser. On the server, a JSON
// API layer sits in front of the controller, the model and the repository. Everything that
// crosses the wire needs a contract: routes, DTOs, serializer groups, an error format, types on
// the other side and a client. It works, but one button now has two codebases.
//
// Then the running task: "Show how many people liked the post." One number next to the heart.
// Count the places with the room. This counter comes back twice: after approach 2, and after
// the reveal. The exact number depends on your stack; the point is the shape: every field
// crosses the wire, so every field exists twice.
#[Component]
function JsonApi(): Node
{
    $browser = ['Node', 'React', 'LikePostButton.tsx'];

    return (
        <Approach browser={{ browser }} answer="JSON">
            <Approach:title>Approach 1: <span className="ph-em">JSON API</span> layer</Approach:title>
            <Box title="API layer" accent>
                <Chip mono>POST /api/likes</Chip>
                <Chip mono>JSON</Chip>
                <Chip mono>Serializer</Chip>
                <Chip mono>LikePayload</Chip>
            </Box>
            <Box title="Controller · model · repository">
                <Chip mono>LikeController.php</Chip>
                <Chip mono>Post.php</Chip>
                <Chip mono>PostRepository.php</Chip>
            </Box>
        </Approach>
    );
}

// Hotwire, htmx, Livewire, Symfony UX: the server renders HTML, and the browser swaps it in. The
// API layer goes away: the controller answers with HTML from a Twig view, and the state lives on
// the server. The like count now touches the entity, the migration, the controller and the
// button partial: four places. This is a big step. But look at what is still split, on the next
// slide.
#[Component]
function HtmlOverTheWire(): Node
{
    $browser = ['Turbo', 'Stimulus'];

    return (
        <Approach browser={{ browser }} answer="HTML">
            <Approach:title>Approach 2: <span className="ph-em">HTML</span> over the wire</Approach:title>
            <Approach:footer>One app · one language · like count: <span className="ph-em">9 → 4 places</span></Approach:footer>
            <Box title="API layer" gone>
                <span className="text-[18px] text-(--text-secondary)">removed</span>
            </Box>
            <Box title="Controller · model · view" accent>
                <Chip mono>LikeController.php</Chip>
                <Chip mono>Post.php</Chip>
                <Chip mono>_like.html.twig</Chip>
            </Box>
        </Approach>
    );
}

// Here is the like button with approach 2. It is one thing in our heads: a component with state,
// an action and markup. In the code it is two files, in two languages, and they know each other
// only by strings: the route name and its parameter, the template path, and the variable names.
// Rename "liked" on one side and you find out at runtime. The highlighted lines are the lines
// with a wire.
#[Component]
function TwoFiles(): Node
{
    $controller = <<<'PHP'
        #[Route('/like/{id}', name: 'like')]
        public function like(Post $post): Response
        {
            $post->toggleLike();

            return $this->render(
                'like/_button.html.twig', [
                    'id' => $post->getId(),
                    'liked' => $post->isLiked(),
                ],
            );
        }
        PHP;

    $template = <<<'TWIG'
        <form method="post"
          action="{{ path('like', {id: id}) }}">
          <button>
            {{ liked ? '♥ Liked' : '♡ Like' }}
          </button>
        </form>
        TWIG;

    return (
        <Slide glowX="50%" glowY="60%" footer="In amber: strings that link the two files">
            <SlideHeading>Two files for <span className="ph-em">one component</span></SlideHeading>
            <div className="mt-12 grid grid-cols-2 items-start gap-8">
                <CodeWindow code={{ controller }} file="LikeController.php" size="sm" focus={{ [1, 7, 8, 9, 10] }} />
                <CodeWindow code={{ template }} file="like/_button.html.twig" size="sm" focus={{ [2, 4] }} />
            </div>
        </Slide>
    );
}

// Read the table as a list of contracts. Each row is a name written twice, in two places, with
// no compiler between them. This is the moment to ask: what if the markup and the PHP that drives
// it were one thing, so that these names are just PHP? Pause, then go to the next slide.
#[Component]
function Wires(): Node
{
    $wires = [
        ['wire' => 'template', 'php' => "render('like/_button.html.twig')", 'twig' => 'the file path'],
        ['wire' => 'variables', 'php' => "'liked' => \$post->isLiked()", 'twig' => '{{ liked }}'],
        ['wire' => 'route', 'php' => "name: 'like'", 'twig' => "path('like', …)"],
        ['wire' => 'parameters', 'php' => "'/like/{id}'", 'twig' => '{id: id}'],
    ];

    return (
        <Slide glowX="40%" glowY="45%" footer="The glue that is left after approach 2">
            <SlideHeading eyebrow="The problem · 5">Each wire is a <span className="ph-em">string</span> nobody checks</SlideHeading>
            <table className="ph-table mt-12">
                <tr><th className="w-[18%]">wire</th><th className="w-[41%]">in PHP</th><th>in Twig</th></tr>
                {% for row in wires %}
                    <tr key={{ row.wire }}><td>{{ row.wire }}</td><td>{{ row.php }}</td><td>{{ row.twig }}</td></tr>
                {% endfor %}
            </table>
            <div className="mt-6">
                <Callout title="A typo is a runtime error" icon="warning" warning>
                    Or a button that does not update and says nothing.
                </Callout>
            </div>
        </Slide>
    );
}

// Let this slide breathe. Say it slowly. Then: "I spent the last months building this. Let me
// show you."
#[Component]
function Question(): Node
{
    return (
        <Slide glowX="30%" glowY="42%" className="flex flex-col justify-center gap-12">
            <GlassPill label="One thing" icon="bulb" active className="self-start" />
            <div>
                <h2 className="ph-title">What if a component was <span className="ph-em">one thing</span>?</h2>
                <p className="ph-lead">Its state, its actions and its markup, in one PHP class. And the browser follows.</p>
            </div>
        </Slide>
    );
}

// The browser and the server of an approach: the browser sends a POST and gets the answer
// (JSON or HTML). The server boxes are the children.
#[Component]
function Approach(Html $title, array $browser, string $answer, Html $children, ?Html $footer = null): Node
{
    return (
        <Slide glowX="66%" glowY="44%">
            <SlideHeading>{{ title }}</SlideHeading>
            <div className="mt-12 flex items-center gap-4">
                <div className="flex w-[280px] flex-col items-center gap-3">
                    <FlowNode icon="browser" label="Browser" />
                    {% for name in browser %}<Chip key={{ name }} mono>{{ name }}</Chip>{% endfor %}
                </div>
                <div className="grid w-[150px] gap-8">
                    <Arrow label="POST" tone="accent" />
                    <Arrow label={{ answer }} tone="cool" back />
                </div>
                <div className="ph-card grid flex-1 gap-4">
                    <div className="flex items-center gap-4">
                        <IconOrb icon="server" size="sm" active />
                        <span className="ph-node-label">Server</span>
                    </div>
                    {{ children }}
                </div>
            </div>
            {% if footer %}<div className="ph-footer"><span>{{ footer }}</span></div>{% endif %}
        </Slide>
    );
}

// A box of the server: a part of the code and its files (children). `accent` is the part that
// the slide is about, `gone` a part that went away.
#[Component]
function Box(string $title, Html $children, bool $accent = false, bool $gone = false): Node
{
    $classes = ['ph-box', $accent ? 'is-accent' : '', $gone ? 'is-gone' : ''];
    $titleClasses = ['ph-eyebrow', $gone ? 'line-through' : ''];

    return (
        <div className={{ classes }}>
            <p className={{ titleClasses }}>{{ title }}</p>
            <div className="flex flex-wrap gap-3">{{ children }}</div>
        </div>
    );
}
