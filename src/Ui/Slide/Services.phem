<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function Services(): Node
{
    $code = <<<'PHP'
        #[Component]
        class LatestPosts
        {
            public array $posts;

            public function __construct(private PostRepository $repository) {}

            public function mount(): void
            {
                $this->posts = $this->repository->latest();
            }

            public function render(): Node
            {
                return <ul>
                    {% for post in posts %}
                        <li key={{ post.id }}>{{ post.title }}</li>
                    {% endfor %}
                </ul>;
            }
        }
        PHP;

    return (
        <CodeSlide>
            <CodeWindow code={{ code }} file="src/Ui/LatestPostsPage.phem" size="xs" startNumber={{ 6 }} />
            <CodeSlide.notes>
                <Annotation step="1" muted>Components are services</Annotation>
                <Annotation step="2" muted>mount() loads the data</Annotation>
                <Annotation step="3" muted>render() stays pure</Annotation>
            </CodeSlide.notes>
        </CodeSlide>
    );
}
