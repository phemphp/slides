<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Arrow, Chip, SlideHeading};
use App\Ui\Layout\Slide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function ReactMap(): Node
{
    $rows = [
        ['function MyButton()', '#[Component] function MyButton()'],
        ['export default function App()', "#[Page('/')] final class App"],
        ['useState', '#[State] public int $count'],
        ['onClick={handleClick}', 'onClick={{ handleClick }}'],
        ['items.map(i => <li />)', '{% for i in items %}<li />{% endfor %}'],
        ['createContext, useContext', '#[Provide], #[Context]'],
    ];

    return (
        <Slide glowX="70%" glowY="50%" footer="The handler runs on the server · the state lives in the class">
            <SlideHeading eyebrow="What changes for you">The same model as <span className="ph-em">React</span></SlideHeading>
            <div className="mt-10">
                <Mapping from="React" to="Phem" rows={{ rows }} />
            </div>
        </Slide>
    );
}

#[Component]
function Mapping(string $from, string $to, array $rows): Node
{
    return (
        <div className="grid grid-cols-[auto_140px_1fr] items-center gap-x-6 gap-y-4">
            <p className="ph-eyebrow m-0 justify-self-end">{{ from }}</p>
            <span></span>
            <p className="ph-eyebrow ph-em-cool m-0">{{ to }}</p>
            {% for row in rows %}
                <Chip key={{ row[0] }} mono className="justify-self-end whitespace-nowrap">{{ row[0] }}</Chip>
                <Arrow tone="accent" />
                <Chip mono dot="accent-cool" className="justify-self-start whitespace-nowrap">{{ row[1] }}</Chip>
            {% endfor %}
        </div>
    );
}
