<?phem

namespace App\Ui\Slide;

use Phem\Node;

// The slides of the presentation, in their order. Each slide has its own file, with its number
// as the prefix. A slide is markup: it renders only when it is the current slide. A dynamic slide
// is a component with its own handlers. The speaker notes are the comments of the slide
// components.
final class Slides
{
    /**
     * @return list<Node>
     */
    public function all(): array
    {
        return [
            // Who I am and what this talk is about.
            <Cover />,

            // The audience joins on their phones, to follow the slides and use the live example.
            <Join />,

            // One like button, the techs of the usual ways, and the wires it needs.
            <Example />,
            <Stack />,
            <ThreeFiles />,

            // The reveal: one PHP class holds the state, the actions and the markup.
            <Reveal />,
            <ClassComponent />,
            <FunctionComponent />,
            <Action />,
            <Services />,
            <TwigCompare />,

            // How it works: compile to Twig, then events over HTTP.
            <Compile />,
            <EventFlow />,

            // What changes for you, the limits, a live demo and the recap.
            <WiresGone />,
            <ReactMap />,
            <TradeOffs />,
            <Demo />,
            <Thanks />,

            // Extra slide, for reference.
            <DesignSheet />,
        ];
    }
}
