<?phem

namespace App\Ui\Slide;

use Phem\Node;

final class Slides
{
    public function all(): array
    {
        return [
            // Who I am and what this talk is about.
            <Cover />,

            // The audience joins on their phones, to follow the slides and use the live example.
            <Join />,

            // One like button, the techs of the usual ways, and the wires it needs.
            <Example />,
            <Stack />,
            <ThreeFiles />,

            // The reveal: one PHP class holds the state, the actions and the markup.
            <Reveal />,
            <Anatomy />,
            <FunctionComponent />,
            <ClassComponent />,
            <PageComponent />,
            <Services />,
            <TwigCompare />,

            // How it works: compile to Twig, then events over HTTP.
            <Compile />,
            <EventFlow />,

            // What changes for you, the limits, a live demo and the recap.
            <WiresGone />,
            <ReactMap />,
            <TradeOffs />,
            <Demo />,
            <Thanks />,

            // Extra slide, for reference.
            <DesignSheet />,
        ];
    }
}
