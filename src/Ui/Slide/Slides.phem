<?phem

namespace App\Ui\Slide;

use Phem\Node;

final class Slides
{
    public function all(): array
    {
        return [
            // Who I am and what this talk is about.
            <Cover />,

            // One like button, and the wires it needs.
            <Example />,
            <ThreeFiles />,

            // The reveal: one PHP class holds the state, the actions and the markup.
            <Reveal />,
            <Anatomy />,
            <FunctionComponent />,
            <ClassComponent />,
            <PageAnatomy />,
            <PageComponent />,
            <Services />,
            <DocumentCompare />,

            // Four features: save in a transaction, push to each browser, go to another page, and show
            // an error page.
            <Transactional />,
            <Broadcast />,
            <RedirectTo />,
            <ErrorPage />,

            // How it works: compile to Twig, then events over HTTP.
            <Compile />,
            <EventFlow />,

            // The tools: the editors read .phem files through the language server, and the coding agents
            // get the docs and the check through the MCP server.
            <EditorSupport />,

            // The packages: a Composer package of components compiles with the app.
            <Packages />,

            // The limits, a live demo and the recap.
            <TradeOffs />,
            <Demo />,
            <Thanks />,
        ];
    }
}
