<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Arrow, Chip, SlideHeading};
use App\Ui\Layout\Slide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function WiresGone(): Node
{
    $rows = [
        ["render('…/_button.html.twig')", 'render()'],
        ["'liked' => \$post->isLiked()", '#[State] $liked'],
        ["name: 'like', path('like')", 'onClick={{ toggle }}'],
        ["'/like/{id}', {id: id}", 'the state of the button'],
    ];

    $counts = [
        ['label' => 'JSON API', 'places' => 9, 'phem' => false],
        ['label' => 'HTML over the wire', 'places' => 4, 'phem' => false],
        ['label' => 'Phem', 'places' => 3, 'phem' => true],
    ];

    return (
        <Slide glowX="70%" glowY="50%" footer="Each string becomes PHP · phemc checks it before you run it">
            <SlideHeading eyebrow="What changes for you">Where the <span className="ph-em">wires</span> went</SlideHeading>
            <div className="mt-9">
                <Mapping from="Approach 2" to="Phem" rows={{ rows }} />
            </div>
            <div className="ph-card mt-8 flex items-center gap-12 py-5">
                <div className="flex-1">
                    <p className="ph-eyebrow m-0">The like count</p>
                    <p className="m-0 mt-2 [font:var(--text-caption)] text-(--text-secondary)">Entity, migration, one .phem file.</p>
                </div>
                {% for count in counts %}
                    <p key={{ count.label }} className={{ ['m-0 flex items-baseline gap-4 [font:var(--text-body)]', count.phem ? '' : 'text-(--text-secondary)'] }}>
                        {{ count.label }}
                        <span className={{ ['leading-none font-bold', count.phem ? 'ph-em text-[64px]' : 'text-[48px]'] }}>{{ count.places }}</span>
                    </p>
                {% endfor %}
            </div>
        </Slide>
    );
}

#[Component]
function Mapping(string $from, string $to, array $rows): Node
{
    return (
        <div className="grid grid-cols-[auto_140px_1fr] items-center gap-x-6 gap-y-4">
            <p className="ph-eyebrow m-0 justify-self-end">{{ from }}</p>
            <span></span>
            <p className="ph-eyebrow ph-em-cool m-0">{{ to }}</p>
            {% for row in rows %}
                <Chip key={{ row[0] }} mono className="justify-self-end whitespace-nowrap">{{ row[0] }}</Chip>
                <Arrow tone="accent" />
                <Chip mono dot="accent-cool" className="justify-self-start whitespace-nowrap">{{ row[1] }}</Chip>
            {% endfor %}
        </div>
    );
}
