<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{GlassPill, Slide};
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function Question(): Node
{
    return (
        <Slide glowX="30%" glowY="42%" className="flex flex-col justify-center gap-12">
            <GlassPill label="One thing" icon="bulb" active className="self-start" />
            <div>
                <h2 className="ph-title">What if a component was <span className="ph-em">one thing</span>?</h2>
                <p className="ph-lead">Its state, its actions and its markup, in one PHP class. And the browser follows.</p>
            </div>
        </Slide>
    );
}
