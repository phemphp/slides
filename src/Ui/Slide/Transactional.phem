<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function Transactional(): Node
{
    $code = <<<'PHP'
        use Phem\Attribute\Transactional;

        #[Component]
        class LikeButton
        {
            #[Prop] public Post $post;

            #[Transactional]
            public function like(): void
            {
                ++$this->post->likes;
            }

            public function render(): Node
            {
                return <button onClick={{ like }}>
                    ♥ {{ post.likes }}
                </button>;
            }
        }
        PHP;

    return (
        <CodeSlide>
            <CodeWindow code={{ code }} file="src/Ui/LikeButton.phem" size="xs" startNumber={{ 5 }} focus={{ [12] }} dim={{ false }} />
            <CodeSlide.notes>
                <Annotation step="1" muted>Mark the handler</Annotation>
                <Annotation step="2" muted>No flush() in the code</Annotation>
                <Annotation step="3" muted>A return commits</Annotation>
                <Annotation step="4" muted>A throw rolls back</Annotation>
            </CodeSlide.notes>
            <CodeSlide.speakerNotes>
                <ul>
                    <li>No flush()</li>
                    <li>Return commits, throw rolls back</li>
                </ul>
            </CodeSlide.speakerNotes>
        </CodeSlide>
    );
}
