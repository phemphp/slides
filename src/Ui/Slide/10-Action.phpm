<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{Button, Chip, CodeWindow, Sandbox, Slide, SlideHeading, StepMarker};
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function Action(): Node
{
    $code = <<<'PHP'
        #[Component] final class LikeButton 
        {
            #[State] public bool $liked = false;

            public function toggle(): void {
                $this->liked = !$this->liked;
            }

            public function render(): Node {
                return <button onClick={{ toggle }}>
                    {{ liked ? '♥ Liked' : '♡ Like' }}
                </button>;
            }
        }
        PHP;

    return (
        <Slide glowX="82%" glowY="12%" className="pt-16">
            <SlideHeading>The handler runs on the <span className="ph-em">server</span></SlideHeading>
            <Sandbox url="/posts/42" className="mt-9">
                <CodeWindow code={{ code }} file="LikeButton.phpm" size="sm" focus={{ [3, 5, 6, 7] }} steps={{ {3: '3', 5: '2'} }} />
                <Sandbox:preview>
                    <p className="ph-eyebrow m-0">Blog</p>
                    <h3>Hello, components</h3>
                    <p className="m-0 text-[18px] text-(--text-secondary)">A short post with one button.</p>
                    <div className="flex items-center gap-4">
                        <Button pressed click>♥ Liked</Button>
                        <StepMarker small>1</StepMarker>
                    </div>
                </Sandbox:preview>
                <Sandbox:status>
                    <Chip mono>handler: toggle</Chip>
                    <Chip mono>liked: true</Chip>
                </Sandbox:status>
            </Sandbox>
        </Slide>
    );
}
