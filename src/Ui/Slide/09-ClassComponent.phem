<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeSlide, CodeWindow};
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function ClassComponent(): Node
{
    $code = <<<'PHP'
        #[Component]
        final class LikeButton 
        {
            #[State] public bool $liked = false;

            public function toggle(): void {
                $this->liked = !$this->liked;
            }

            public function render(): Node {
                return (
                    <button onClick={{ toggle }}>
                        {{ liked ? '♥ Liked' : '♡ Like' }}
                    </button>
                );
            }
        }
        PHP;

    return (
        <CodeSlide>
            <CodeSlide:title>A component is a <span className="ph-em">PHP class</span></CodeSlide:title>
            <CodeWindow code={{ code }} file="src/Ui/Component/LikeButton.phem" size="sm" focus={{ [1, 4, 6, 7, 8, 10, 11, 12, 13, 14] }} steps={{ {1: '1', 4: '2', 6: '3', 10: '4'} }} />
            <CodeSlide:notes>
                <Annotation step="1">A component</Annotation>
                <Annotation step="2">State is a property</Annotation>
                <Annotation step="3">An action is a method</Annotation>
                <Annotation step="4">The markup uses both</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}
