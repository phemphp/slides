<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, CodeWindow};
use App\Ui\Layout\CodeSlide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function RedirectTo(): Node
{
    $code = <<<'PHP'
        use App\Ui\PostPage;
        use Phem\RedirectTo;

        #[Component]
        class PublishButton
        {
            #[Prop] public Post $post;

            public function publish(): RedirectTo
            {
                // ...

                return new RedirectTo(PostPage::class, ['post' => $this->post]);
            }

            public function render(): Node
            {
                return <button onClick={{ publish }}>Publish</button>;
            }
        }
        PHP;

    return (
        <CodeSlide>
            <CodeWindow code={{ code }} file="src/Ui/PublishButton.phem" size="xs" startNumber={{ 5 }} focus={{ [17] }} dim={{ false }} />
            <CodeSlide.notes>
                <Annotation step="1" muted>Return a RedirectTo</Annotation>
                <Annotation step="2" muted>The page is a class</Annotation>
                <Annotation step="3" muted>The Post gives the id</Annotation>
                <Annotation step="4" muted>Turbo visits the page</Annotation>
            </CodeSlide.notes>
        </CodeSlide>
    );
}
