<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{Arrow, Chip, GlassPill, ListItem, Slide, SlideHeading, Terminal};
use Phem\Attribute\Component;
use Phem\Node;

// Go back to the table of wires from the problem part. Each string now has a PHP name, so your
// IDE and phemc see it: an unknown component or prop is E010–E015, an undefined variable in
// markup is E030. No route and no route parameter: the button knows its own state, and the
// browser sends it back with each event. The counter: three places for the like count, and two
// of them are the database. Be honest: the win is less about the count and more that the
// remaining places are checked.
#[Component]
function WiresGone(): Node
{
    $rows = [
        ["render('…/_button.html.twig')", 'render()'],
        ["'liked' => \$post->isLiked()", '#[State] $liked'],
        ["name: 'like', path('like')", 'onClick={{ toggle }}'],
        ["'/like/{id}', {id: id}", 'the state of the button'],
    ];

    $counts = [
        ['label' => 'JSON API', 'places' => 9, 'phem' => false],
        ['label' => 'HTML over the wire', 'places' => 4, 'phem' => false],
        ['label' => 'Phem', 'places' => 3, 'phem' => true],
    ];

    return (
        <Slide glowX="70%" glowY="50%" footer="Each string becomes PHP · phemc checks it before you run it">
            <SlideHeading eyebrow="What changes for you">Where the <span className="ph-em">wires</span> went</SlideHeading>
            <div className="mt-9">
                <Mapping from="Approach 2" to="Phem" rows={{ rows }} />
            </div>
            <div className="ph-card mt-8 flex items-center gap-12 py-5">
                <div className="flex-1">
                    <p className="ph-eyebrow m-0">The like count</p>
                    <p className="m-0 mt-2 [font:var(--text-caption)] text-(--text-secondary)">Entity, migration, one .phpm file.</p>
                </div>
                {% for count in counts %}
                    <p key={{ count.label }} className={{ ['m-0 flex items-baseline gap-4 [font:var(--text-body)]', count.phem ? '' : 'text-(--text-secondary)'] }}>
                        {{ count.label }}
                        <span className={{ ['leading-none font-bold', count.phem ? 'ph-em text-[64px]' : 'text-[48px]'] }}>{{ count.places }}</span>
                    </p>
                {% endfor %}
            </div>
        </Slide>
    );
}

// For the React people in the room. The ideas are the same: components, props, state, children,
// context, lifting state up. The differences: state is a #[State] property of a class (no hooks,
// phemc even reports a call to a hook as E020), handlers run on the server, and a page is a
// Symfony route. Imported modules become services injected in the constructor.
#[Component]
function ReactMap(): Node
{
    $rows = [
        ['function MyButton()', '#[Component] function MyButton()'],
        ['export default function App()', "#[Page('/')] final class App"],
        ['useState', '#[State] public int $count'],
        ['onClick={handleClick}', 'onClick={{ handleClick }}'],
        ['items.map(i => <li />)', '{% for i in items %}<li />{% endfor %}'],
        ['createContext, useContext', '#[Provide], #[Context]'],
    ];

    return (
        <Slide glowX="70%" glowY="50%" footer="The handler runs on the server · the state lives in the class">
            <SlideHeading eyebrow="What changes for you">The same model as <span className="ph-em">React</span></SlideHeading>
            <div className="mt-10">
                <Mapping from="React" to="Phem" rows={{ rows }} />
            </div>
        </Slide>
    );
}

// Say these before someone asks. Each event is a round trip: about 1 ms on the server, plus the
// network. Animations, drag and drop or anything that must feel instant stays in a normal
// Stimulus controller. State must be JSON values. There is no useEffect, because there is no
// long-lived component on the server. render() must be pure, because Phem renders only the
// components that can change and keeps the others. The project has no release yet.
#[Component]
function TradeOffs(): Node
{
    $tradeOffs = [
        ['title' => 'Each event is a round trip', 'body' => 'Browser-only logic stays in a Stimulus controller.'],
        ['title' => 'State is JSON', 'body' => 'Closures, objects and services are not state.'],
        ['title' => 'No useEffect', 'body' => 'The server keeps no session between events.'],
        ['title' => 'render() must be pure', 'body' => 'Phem skips the components that cannot change.'],
    ];

    return (
        <Slide glowX="30%" glowY="50%" footer="No release yet · the API can still change">
            <SlideHeading eyebrow="What changes for you">The <span className="ph-em">trade-offs</span></SlideHeading>
            <div className="mt-12 grid grid-cols-2 gap-8">
                {% for item in tradeOffs %}
                    <div key={{ item.title }} className="ph-card">
                        <p className="ph-callout-title">{{ item.title }}</p>
                        <p className="ph-callout-body">{{ item.body }}</p>
                    </div>
                {% endfor %}
            </div>
        </Slide>
    );
}

// Demo script, about 5 minutes. 1. make up, open /examples/Profile: click the LikeButton, the
// heart fills; show the request in the network tab: one POST with the handler name. 2. Open
// LikeButton.phpm side by side, change the label, save: phemc watch rebuilds, reload. 3. Open
// /examples/CounterSeparate: two Counter components, each keeps its own state. 4. Make a typo in
// a component name and show the phemc error with the line and column. Backup: a recording of
// the same steps, in case the network fails.
#[Component]
function Demo(): Node
{
    $lines = [
        ['cmd', 'make up'],
        ['ok', 'phemc watch'],
        ['ok', 'FrankenPHP, worker mode'],
        ['ok', 'localhost:8080'],
        ['out', ''],
        ['cmd', 'open /examples/Profile'],
        ['cmd', 'open /examples/CounterSeparate'],
    ];

    return (
        <Slide glowX="22%" glowY="42%" footer="examples/quickstart" className="grid grid-cols-[1fr_560px] items-center gap-16">
            <div>
                <GlassPill label="Live demo" icon="play" active />
                <p className="ph-lead mt-12">Two like buttons, two counters. Each one keeps its own state.</p>
            </div>
            <Terminal title="phem — zsh" lines={{ lines }} />
        </Slide>
    );
}

// Close with the three lines. Then ask for feedback: the project has no release yet, so the API
// can still change, and this is the moment to shape it. Put the repository link and your handle
// on the card before the talk.
#[Component]
function Thanks(): Node
{
    return (
        <Slide glowX="80%" glowY="50%" footer="Phem · no release yet" className="grid grid-cols-[1fr_400px] items-center gap-16">
            <div>
                <SlideHeading eyebrow="Recap">One component, <span className="ph-em">no wires</span></SlideHeading>
                <ul className="ph-list mt-10">
                    <ListItem number="1" title="One file per component" detail="State, actions and markup in one class." active />
                    <ListItem number="2" title="Compiled to PHP and Twig" detail="Checked by phemc before you run it." />
                    <ListItem number="3" title="The browser follows" detail="Events over HTTP, Turbo morphs the page." />
                </ul>
            </div>
            <div className="ph-card flex flex-col items-center gap-4 text-center">
                <img src={{ asset('images/phem-logo.svg') }} alt="The Phem logo" className="w-[107px]" />
                <p className="ph-title">Thank you</p>
                <p className="ph-lead m-0">Questions?</p>
                <Chip mono>[repository link]</Chip>
                <p className="text-[20px] text-(--text-secondary)">@[handle]</p>
            </div>
        </Slide>
    );
}

// Two columns of names in code: the old name (from) and its new name (to), joined by an arrow.
#[Component]
function Mapping(string $from, string $to, array $rows): Node
{
    return (
        <div className="grid grid-cols-[auto_140px_1fr] items-center gap-x-6 gap-y-4">
            <p className="ph-eyebrow m-0 justify-self-end">{{ from }}</p>
            <span></span>
            <p className="ph-eyebrow ph-em-cool m-0">{{ to }}</p>
            {% for row in rows %}
                <Chip key={{ row[0] }} mono className="justify-self-end whitespace-nowrap">{{ row[0] }}</Chip>
                <Arrow tone="accent" />
                <Chip mono dot="accent-cool" className="justify-self-start whitespace-nowrap">{{ row[1] }}</Chip>
            {% endfor %}
        </div>
    );
}
