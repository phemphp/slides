<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{CodeWindow, ListItem, SlideHeading};
use App\Ui\Layout\Slide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function Compile(): Node
{
    $php = <<<'PHP'
        <?php /* compiled by phemc from src/Ui/Badge.phem; do not edit */
        namespace App\Ui;
        #[Component]
        function Badge(Html $children): Node
        {
            return new \Phem\Element('Ui/Badge.0.twig', [
                'children' => $children,
            ]);
        }
        PHP;

    $twig = <<<'TWIG'
        <span class="border-ring rounded-full px-3 py-1">
            {{ children }}
        </span>
        TWIG;

    return (
        <Slide glowX="36%" glowY="58%">
            <div className="mt-8 grid grid-cols-[1fr_340px] items-center gap-12">
                <div className="flex flex-col gap-4">
                    <CodeWindow code={{ php }} file="var/phem/php/Ui/Badge.php" size="sm">
                        <CodeWindow.meta><span className="ph-eyebrow m-0">Generated</span></CodeWindow.meta>
                    </CodeWindow>
                    <CodeWindow code={{ twig }} file="var/phem/templates/Ui/Badge.0.twig" size="sm">
                        <CodeWindow.meta><span className="ph-eyebrow m-0">Generated</span></CodeWindow.meta>
                    </CodeWindow>
                </div>
                <ul className="ph-list">
                    <ListItem icon="code" title=".phem" detail="your source" />
                    <ListItem icon="wrench" title="phemc" detail="checks, then writes" active />
                    <ListItem icon="layers" title="PHP + Twig" detail="one per literal" />
                    <ListItem icon="bolt" title="Twig cache" detail="built before deploy" />
                </ul>
            </div>
        </Slide>
    );
}
