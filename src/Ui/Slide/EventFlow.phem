<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, Arrow, FlowNode, SlideHeading, StepMarker};
use App\Ui\Layout\Slide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function EventFlow(): Node
{
    return (
        <Slide glowX="80%" glowY="38%" footer="No session on the server · the browser keeps the signed state">
            <SlideHeading eyebrow="How it works · an event">What happens when you <span className="ph-em">click Like</span></SlideHeading>
            <div className="mt-12 grid grid-cols-[280px_1fr_280px] items-start gap-6">
                <div className="flex flex-col items-center gap-6">
                    <FlowNode icon="browser" label="Browser" />
                    <Annotation step="4">Morphs only what changed.</Annotation>
                </div>
                <div className="grid gap-10 pt-12">
                    <div className="flex items-center gap-3">
                        <StepMarker small>1</StepMarker>
                        <Arrow label="POST /posts/42 {signature, handler}" tone="accent" className="flex-1" />
                    </div>
                    <div className="flex items-center gap-3">
                        <StepMarker small tone="cool">3</StepMarker>
                        <Arrow label="Turbo Streams + changed state" tone="cool" back className="flex-1" />
                    </div>
                </div>
                <div className="flex flex-col items-center gap-6">
                    <FlowNode icon="server" label="Server" active />
                    <Annotation step="2">Restores the state and runs toggle().</Annotation>
                </div>
            </div>
        </Slide>
    );
}
