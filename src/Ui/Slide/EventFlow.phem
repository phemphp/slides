<?phem

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, Arrow, FlowNode, SlideHeading, StepMarker};
use App\Ui\Layout\Slide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function EventFlow(): Node
{
    // The row puts the bottom of the marker on the bottom of the arrow line. This moves the
    // center of the marker (28px) to the center of the line (3px).
    $onLine = 'translate-y-[12.5px]';

    return (
        <Slide glowX="80%" glowY="38%">
            <SlideHeading>What happens when you <span className="ph-em">click Like</span></SlideHeading>
            <div className="mt-24 grid grid-cols-[280px_1fr_280px] items-start gap-6">
                <div className="flex flex-col items-center gap-6">
                    <FlowNode icon="browser" label="Browser" />
                    <Annotation step="4" tone="cool">Morphs only what changed.</Annotation>
                </div>
                <div className="grid gap-10 pt-12">
                    <div className="flex items-end gap-3">
                        <StepMarker small className={{ onLine }}>1</StepMarker>
                        <Arrow label="POST /posts/42 {signature, handler}" tone="accent" className="flex-1" />
                    </div>
                    <div className="flex items-end gap-3">
                        <StepMarker small tone="cool" className={{ onLine }}>3</StepMarker>
                        <Arrow label="Turbo Streams + changed state" tone="cool" back className="flex-1" />
                    </div>
                </div>
                <div className="flex flex-col items-center gap-6">
                    <FlowNode icon="server" label="Server" active />
                    <Annotation step="2">Restores the state and runs handler().</Annotation>
                </div>
            </div>
        </Slide>
    );
}
