<?phem

namespace App\Ui\Slide;

use App\Ui\Component\Chip;
use App\Ui\Layout\Slide;
use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function Reveal(): Node
{
    return (
        <Slide glowX="28%" glowY="46%" className="grid grid-cols-[340px_1fr] items-center gap-20">
            <span className="ph-orb is-active" style="--size: 340px; --ring: 16px;">
                <span className="ph-orb-ring"></span>
                <span className="ph-orb-disc"></span>
                <img src={{ asset('images/phem-logo.svg') }} alt="The Phem logo in light brushed metal: an elephant with a sprout" className="relative w-[180px]" />
            </span>
            <div>
                <p className="ph-eyebrow">Meet</p>
                <h1 className="ph-display">Phem</h1>
                <p className="ph-lead">UI server components for Symfony web apps, <br/>made of old friends.</p>
                <div className="mt-10 flex flex-wrap gap-3">
                    <Chip mono>PHP</Chip>
                    <Chip mono>Symfony</Chip>
                    <Chip mono>Twig</Chip>
                    <Chip mono>Turbo</Chip>
                    <Chip mono>Stimulus</Chip>
                    <Chip mono>Rust</Chip>
                </div>
                <a href="https://phem.dev" target="_blank" rel="noopener" className="ph-em mt-10 inline-block text-[26px] font-medium font-(family-name:--font-mono) hover:underline">https://phem.dev</a>
            </div>
            <Slide.speakerNotes>
                <ul>
                    <li>Old friends: PHP, Symfony, Twig, Turbo, Stimulus</li>
                    <li>The compiler is in Rust</li>
                </ul>
            </Slide.speakerNotes>
        </Slide>
    );
}
