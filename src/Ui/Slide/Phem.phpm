<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{Annotation, Button, Chip, CodeSlide, CodeWindow, ComparisonSlide, ListItem, Sandbox, Slide, SlideHeading, SplitSlide, StepMarker};
use Phem\Attribute\Component;
use Phem\Node;

// Say your own story of the name here. One sentence: a .phpm file is a PHP file with markup
// literals, the way a .jsx file is JavaScript with JSX. A compiler written in Rust (phemc) turns
// it into plain PHP and Twig. A Symfony bundle runs it. Turbo and Stimulus carry the events. Now
// the same like button.
#[Component]
function Reveal(): Node
{
    return (
        <Slide glowX="28%" glowY="46%" className="grid grid-cols-[340px_1fr] items-center gap-20">
            <span className="ph-orb is-active" style="--size: 340px; --ring: 24px;">
                <span className="ph-orb-ring"></span>
                <span className="ph-orb-disc"></span>
                <img src={{ asset('images/phem-logo-metal.svg') }} alt="The Phem logo in light brushed metal: an elephant with a sprout" className="relative w-[120px]" />
            </span>
            <div>
                <p className="ph-eyebrow">Meet</p>
                <h1 className="ph-display">Phem</h1>
                <p className="ph-lead">The React component model for Symfony.</p>
                <div className="mt-10 flex flex-wrap gap-3">
                    <Chip mono>Symfony</Chip>
                    <Chip mono>Bundle</Chip>
                    <Chip mono>UI</Chip>
                    <Chip mono>Developer Experience</Chip>
                </div>
            </div>
        </Slide>
    );
}

// The simplest component. Say it early: this is not a new language. It is PHP, with Twig for the
// markup. 1: it lives in the new file type, .phpm. A .phpm file starts with the <?phpm open tag.
// It is a PHP file with markup literals, the way a .jsx file is JavaScript with JSX.
// 2: #[Component] marks a plain PHP function as a component (a function without it stays a
// normal function). 3: its parameters are its props: here $liked, a bool with a default. 4: it
// returns markup; inside it you write Twig, so {{ liked ? … }} reads the prop by name. Use it
// like an HTML tag: <LikeButton liked={{ true }} />. A component that only returns markup
// renders as plain Twig, with no PHP call. No template path, no variables array. Next slide:
// give it state and an action.
#[Component]
function FunctionComponent(): Node
{
    $code = <<<'PHP'
        <?phpm

        #[Component]
        function LikeButton(bool $liked = false): Node
        {
            return (
                <button>
                    {{ liked ? '♥ Liked' : '♡ Like' }}
                </button>
            );
        }
        PHP;

    $usage = '<LikeButton liked={{ true }} />';

    return (
        <CodeSlide eyebrow="Phem · basic component" footer="Not a new language · just PHP + Twig + Component system">
            <CodeSlide:title>A component is a <span className="ph-em">PHP function</span></CodeSlide:title>
            <div className="grid gap-6">
                <CodeWindow code={{ code }} file="src/Components/LikeButton.phpm" size="sm" focus={{ [1, 3, 4, 7, 8, 9] }} steps={{ {1: '1', 3: '2', 4: '3', 7: '4'} }} />
                <div className="flex items-center gap-4">
                    <span className="ph-eyebrow m-0">Use it</span>
                    <Chip mono>{{ usage }}</Chip>
                </div>
            </div>
            <CodeSlide:notes>
                <Annotation step="1">A new file type: .phpm</Annotation>
                <Annotation step="2">Mark a function</Annotation>
                <Annotation step="3">Parameters are props</Annotation>
                <Annotation step="4">It returns markup</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}

// This is the real LikeButton of the quickstart. A .phpm file is a PHP file with markup
// literals, the way a .jsx file is JavaScript with JSX. 1: #[Component] makes the class a
// component. 2: #[State] makes $liked its state. 3: toggle() is an action, a plain method that
// changes the state. 4: render() returns markup; inside it you write Twig, {{ }}, and
// onClick={{ toggle }} passes the method itself. No template path, no variables array, no route.
// Use it as <LikeButton />; each one keeps its own state.
#[Component]
function ClassComponent(): Node
{
    $code = <<<'PHP'
        #[Component]
        final class LikeButton {
            #[State] public bool $liked = false;

            public function toggle(): void {
                $this->liked = !$this->liked;
            }

            public function render(): Node {
                return <button onClick={{ toggle }}>
                    {{ liked ? '♥ Liked' : '♡ Like' }}
                </button>;
            }
        }
        PHP;

    return (
        <CodeSlide eyebrow="Phem · a component" footer="One file · state, action and markup together">
            <CodeSlide:title>A component is a <span className="ph-em">PHP class</span></CodeSlide:title>
            <CodeWindow code={{ code }} file="src/Components/LikeButton.phpm" size="sm" focus={{ [1, 3, 5, 6, 10, 11] }} steps={{ {1: '1', 3: '2', 5: '3', 10: '4'} }} />
            <CodeSlide:notes>
                <Annotation step="1">A component</Annotation>
                <Annotation step="2">State is a property</Annotation>
                <Annotation step="3">An action is a method</Annotation>
                <Annotation step="4">The markup uses both</Annotation>
            </CodeSlide:notes>
        </CodeSlide>
    );
}

// Follow the numbers. 1: the user clicks the button. 2: onClick={{ toggle }} passes the method
// itself, not a URL. 3: toggle() runs on the server, in PHP, with the state of this button. Phem
// renders the button again and the browser shows "♥ Liked". No route, no controller, no
// JavaScript to write. The status row shows what the browser sent: the handler name. Its state
// is now liked: true.
#[Component]
function Action(): Node
{
    $code = <<<'PHP'
        #[Component] final class LikeButton {
            #[State] public bool $liked = false;
            public function toggle(): void {
                $this->liked = !$this->liked;
            }
            public function render(): Node {
                return <button onClick={{ toggle }}>
                    {{ liked ? '♥ Liked' : '♡ Like' }}
                </button>;
            }
        }
        PHP;

    return (
        <Slide glowX="82%" glowY="12%" footer="1 click · 2 the button calls toggle · 3 toggle runs on the server" className="pt-16">
            <SlideHeading eyebrow="Phem · an action">The handler runs on the <span className="ph-em">server</span></SlideHeading>
            <Sandbox url="/posts/42" className="mt-9">
                <CodeWindow code={{ code }} file="LikeButton.phpm" size="sm" focus={{ [3, 4, 5, 7] }} steps={{ {3: '3', 7: '2'} }} />
                <Sandbox:preview>
                    <p className="ph-eyebrow m-0">Blog</p>
                    <h3>Hello, components</h3>
                    <p className="m-0 text-[18px] text-(--text-secondary)">A short post with one button.</p>
                    <div className="flex items-center gap-4">
                        <Button pressed click>♥ Liked</Button>
                        <StepMarker small>1</StepMarker>
                    </div>
                </Sandbox:preview>
                <Sandbox:status>
                    <Chip mono>handler: toggle</Chip>
                    <Chip mono>liked: true</Chip>
                </Sandbox:status>
            </Sandbox>
        </Slide>
    );
}

// This answers "where does the like get saved?". LikePostButton gets a Post entity as a prop, and
// the entity has a liked bool property. A component class is a Symfony service, so its
// constructor gets the services it needs (autowiring). 1: the Post comes in as a prop:
// <LikePostButton post={{ post }} />. 2: the PostRepository comes in the constructor. 3: the
// handler flips $post->liked and saves it. With Doctrine ORM, each handler runs in a transaction:
// Phem flushes and commits when the handler returns. This is the server action, with no API
// between it and the button.
#[Component]
function Services(): Node
{
    $code = <<<'PHP'
        #[Component]
        final class LikePostButton {
            #[Prop] public Post $post;

            public function __construct(
                private PostRepository $posts,
            ) {}

            public function toggle(): void {
                $this->post->liked = !$this->post->liked;
                $this->posts->save($this->post);
            }
            // render(): {{ post.liked ? '♥ Liked' : '♡ Like' }}
        }
        PHP;

    return (
        <SplitSlide eyebrow="Phem · services" footer="The handler is plain PHP · call any service">
            <SplitSlide:title>Components are <span className="ph-em">services</span></SplitSlide:title>
            <ListItem step="1" title="A Post entity as a prop" />
            <ListItem step="2" title="Autowired by Symfony" />
            <ListItem step="3" title="Saved in the handler" />
            <SplitSlide:code>
                <CodeWindow code={{ code }} file="src/Components/LikePostButton.phpm" size="sm" focus={{ [3, 5, 6, 7, 11] }} steps={{ {3: '1', 6: '2', 11: '3'} }} />
            </SplitSlide:code>
        </SplitSlide>
    );
}

// This slide speaks to Twig users. A child template extends a parent by path and fills blocks by
// name. A Phem page does the same: Document is the parent, a component with a title slot and
// children. The default block (body) becomes the children: what is inside the tag. include()
// becomes a component tag, <LikeButton />, and phemc checks that the component exists and that
// its props are right (E010–E015). Next slide shows that this is literally what it compiles to.
#[Component]
function TwigCompare(): Node
{
    $before = <<<'TWIG'
        {% extends 'base.html.twig' %}
        {% block title %}My post{% endblock %}
        {% block body %}
            <h1>My post</h1>
            {{ include('_like.html.twig') }}
        {% endblock %}
        TWIG;

    $after = <<<'PHP'
        return <Document>
            <Document:title>My post</Document:title>
            <h1>My post</h1>
            <LikeButton />
        </Document>;
        PHP;

    return (
        <ComparisonSlide eyebrow="Phem · components" beforeLabel="Before" afterLabel="After" footer="The same idea as Twig inheritance, with types">
            <ComparisonSlide:title>From child template to <span className="ph-em">component</span></ComparisonSlide:title>
            <ComparisonSlide:before>
                <CodeWindow code={{ before }} file="post.html.twig" size="sm" numbers={{ false }} focus={{ [1, 2, 5] }} steps={{ {1: '1', 2: '2', 5: '3'} }} />
            </ComparisonSlide:before>
            <ComparisonSlide:after>
                <CodeWindow code={{ after }} file="PostPage.phpm" size="sm" numbers={{ false }} focus={{ [1, 2, 4] }} steps={{ {1: '1', 2: '2', 4: '3'} }} />
            </ComparisonSlide:after>
            <ul className="ph-list grid-cols-3">
                <ListItem step="1" title="A parent by class" />
                <ListItem step="2" title="A block is a slot" />
                <ListItem step="3" title="Checked by phemc" />
            </ul>
        </ComparisonSlide>
    );
}
