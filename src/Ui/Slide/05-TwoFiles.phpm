<?phpm

namespace App\Ui\Slide;

use App\Ui\Component\{CodeWindow, Slide, SlideHeading};
use Phem\Attribute\Component;
use Phem\Node;

// Read the amber strings as a list of contracts. Each one is a name written twice, in two places,
// with no compiler between them. The template: the file path in render(). The variables: 'id'
// and 'likes' in the array, {{ id }} and {{ likes }} in Twig. The route: 'post_like' and
// path('post_like', …). The parameters: '/posts/{id}/like' and {id: id}. A typo is a runtime
// error, or a button that does not update and says nothing. This is the moment to ask: what if
// the markup and the PHP that drives it were one thing, so that these names are just PHP? Pause,
// then go to the next slide.
#[Component]
function TwoFiles(): Node
{
    $controller = <<<'PHP'
        #[Route('/posts/{id}/like', 'post_like')]
        public function like(Post $post): Response
        {
            $post->like();

            return $this->render(
                'like_button.html.twig', [
                    'id' => $post->getId(),
                    'likes' => $post->getLikes(),
                ],
            );
        }
        PHP;

    $template = <<<'TWIG'
        <form method="post"
          action="{{ path('post_like', {id: id}) }}">
          <button>
            {{ likes > 0 ? '♥' : '♡' }} {{ likes }}
          </button>
        </form>
        TWIG;

    return (
        <Slide glowX="50%" glowY="60%" footer="In amber: strings that link the two files">
            <SlideHeading>Two files for <span className="ph-em">one component</span></SlideHeading>
            <div className="mt-12 grid grid-cols-2 items-start gap-8">
                <CodeWindow code={{ controller }} file="PostController.php" size="sm" focus={{ [1, 7, 8, 9, 10] }} />
                <CodeWindow code={{ template }} file="like_button.html.twig" size="sm" focus={{ [2, 4] }} />
            </div>
        </Slide>
    );
}
