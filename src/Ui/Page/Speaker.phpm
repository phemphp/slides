<?phpm

namespace App\Ui\Page;

use App\Ui\Component\Deck;
use App\Deck\Role;
use Phem\Attribute\{Page, Subscribe};
use Phem\Node;

// The view of the speaker (the projector): the keyboard moves the slides of all the screens.
// App\Security\SpeakerAccess protects it.
#[Page('/speaker'), Subscribe]
function Speaker(): Node
{
    $role = Role::Speaker;

    return (
        <Document>
            <Document:title>Phem, live (speaker)</Document:title>
            <Deck role={{ role }} />
        </Document>
    );
}
