<?phpm

namespace App\Ui\Page;

use App\Ui\Component\Deck;
use App\Deck\Role;
use Phem\Attribute\{Page, Broadcast};
use Phem\Node;

// The view of the audience (the QR code opens it): the current slide, and its interactive parts.
#[Page('/'), Broadcast]
function Audience(): Node
{
    $role = Role::Audience;

    return (
        <Document>
            <Document:title>Phem, live</Document:title>
            <Deck role={{ role }} />
        </Document>
    );
}
