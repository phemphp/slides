<?phem

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\{Html, Node};

#[Component]
function Annotation(Html $children, ?string $step = null, ?Html $detail = null): Node
{
    return (
        <div className="ph-note">
            {% if step %}<StepMarker small>{{ step }}</StepMarker>{% endif %}
            <span>
                {{ children }}
                {% if detail %}<small>{{ detail }}</small>{% endif %}
            </span>
        </div>
    );
}
