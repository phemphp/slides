<?phem

namespace App\Ui\Component;

use App\Entity\Post;
use Phem\Attribute\{Broadcast, BroadcastKey, Component, Prop, Transactional};
use Phem\Node;

// Each change of the likes of the post renders the button again in all the browsers: a like, and
// the reset of the example slide (see LikeReset).
#[Component, Broadcast(on: [Post::class => ['likes']])]
final class LikeButton
{
    #[Prop, BroadcastKey] public Post $post;

    #[Transactional]
    public function like(): void
    {
        ++$this->post->likes;
    }

    public function render(): Node
    {
        return (
            <button type="button" onClick={{ like }} className="ph-button ph-button-primary ph-like cursor-pointer">
                <span><span className="ph-like-heart">{{ post.likes > 0 ? '♥' : '♡' }}</span> Like</span>
                {% if post.likes > 0 %}
                    <span className="border-l border-(--edge-strong) pl-3 tabular-nums">{{ post.likes }}</span>
                {% endif %}
            </button>
        );
    }
}
