<?phem

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\{Html, Node};

#[Component]
function Terminal(array $lines, string $title = 'zsh', string $className = ''): Node
{
    $html = [];
    foreach ($lines as [$kind, $text]) {
        $text = htmlspecialchars($text);
        $html[] = match ($kind) {
            'cmd' => '<span class="ph-prompt">$</span> <span class="ph-cmd">'.$text.'</span>',
            'dim' => '<span class="ph-dim">'.$text.'</span>',
            'ok' => '<span class="ph-ok">✓</span> '.$text,
            'err' => '<span class="ph-err">✕</span> '.$text,
            default => $text,
        };
    }
    // One string: the white space between the lines of a <pre> counts.
    $body = new Html(implode("\n", $html));
    $classes = ['ph-terminal', $className];

    return (
        <div className={{ classes }}>
            <div className="ph-window-bar">
                <span className="ph-window-dots"><span></span><span></span><span></span></span>
                <span className="ph-window-tab is-active">{{ title }}</span>
            </div>
            <pre className="ph-terminal-body">{{ body }}</pre>
        </div>
    );
}
