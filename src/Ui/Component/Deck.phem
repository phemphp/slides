<?phem

namespace App\Ui\Component;

use App\Deck\Step;
use App\Entity\Presentation;
use App\Repository\PresentationRepository;
use App\Ui\Slide\Slides;
use Phem\Attribute\{Component, Provide};
use Phem\Node;

#[Component]
final class Deck
{
    // The current point of the slide, for the slides that show their points one at a time.
    #[Provide]
    public Step $step;

    private Presentation $presentation;
    private int $index = 0;
    private int $total = 0;
    private ?Node $slide = null;

    /** @var list<Node> */
    private array $slides;

    public function __construct(
        private readonly PresentationRepository $repository,
    ) {
        $this->slides = new Slides()->all();
        $this->step = new Step();
    }

    public function mount(): void
    {
        $this->presentation = $this->repository->get();
        $this->load($this->presentation->slide);
        $this->step = new Step(max(1, $this->presentation->step));
    }

    public function render(): Node
    {
        $number = $this->index + 1;

        return (
            <section
                id="deck"
                className="relative flex h-full flex-col overflow-hidden"
                data-phem-transition
            >
                <div className="ph-deck-stage">
                    <div>{{ slide }}</div>
                </div>
                <DeckNav presentation={{ presentation }} number={{ number }} total={{ total }} />
            </section>
        );
    }

    private function load(int $index): void
    {
        $this->index = $this->clamp($index);
        $this->total = \count($this->slides);
        $this->slide = $this->slides[$this->index] ?? null;
    }

    private function clamp(int $index): int
    {
        return max(0, min($index, \count($this->slides) - 1));
    }
}
