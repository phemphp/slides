<?phem

namespace App\Ui\Component;

use App\Ui\Code\Highlighter;
use App\Deck\Step;
use Phem\Attribute\{Component, Context};
use Phem\{Html, Node};

// With "reveal", the markers of the steps show one at a time (see Slide): the marker of the
// current point is amber and its lines (stepFocus, or the line of the marker) are the focus. The
// markers of the earlier points are "done", and the markers of the later points do not show.
// With "dim" false, the lines out of focus keep full opacity.
#[Component]
function CodeWindow(
    string $code,
    string $file = '',
    array $tabs = [],
    ?Html $meta = null,
    string $size = '',
    array $focus = [],
    array $added = [],
    array $removed = [],
    array $steps = [],
    array $tags = [],
    bool $numbers = true,
    string $className = '',
    bool $reveal = false,
    array $stepFocus = [],
    bool $dim = true,
    #[Context] ?Step $step = null,
): Node {
    $current = 0;
    if ($reveal && $steps) {
        $current = min($step?->current ?? 1, max(array_map('intval', $steps)));
        $focus = $stepFocus[$current] ?? array_keys(array_filter($steps, fn ($s) => (int) $s === $current));
    }
    $lines = [];
    foreach (Highlighter::lines($code) as $i => $html) {
        $n = $i + 1;
        $class = 'ph-line'
            .(\in_array($n, $focus, true) ? ' is-focus' : '')
            .(\in_array($n, $added, true) ? ' is-add' : '')
            .(\in_array($n, $removed, true) ? ' is-del' : '');
        if (isset($tags[$n])) {
            $html .= '<span class="ph-line-tag">'.htmlspecialchars($tags[$n]).'</span>';
        }
        if (isset($steps[$n]) && (!$reveal || (int) $steps[$n] <= $current)) {
            $done = $reveal && (int) $steps[$n] < $current ? ' is-done' : '';
            $html .= ' <span class="ph-step ph-step-sm'.$done.'">'.htmlspecialchars((string) $steps[$n]).'</span>';
        }
        $lines[] = '<span class="'.$class.'">'.$html.'</span>';
    }
    // One string: the white space between the lines of a <pre> counts.
    $body = new Html(implode('', $lines));
    $codeClasses = ['ph-code', $size ? 'ph-code-'.$size : '', $focus && $dim ? 'has-focus' : '', $numbers ? '' : 'no-numbers'];
    $classes = ['ph-window', $className];

    return (
        <div className={{ classes }}>
            <div className="ph-window-bar">
                <span className="ph-window-dots"><span></span><span></span><span></span></span>
                {% if file %}<span className="ph-window-tab is-active">{{ file }}</span>{% endif %}
                {% for tab in tabs %}<span key={{ tab }} className="ph-window-tab">{{ tab }}</span>{% endfor %}
                {% if meta %}<span className="ph-window-meta">{{ meta }}</span>{% endif %}
            </div>
            <pre className={{ codeClasses }}><code>{{ body }}</code></pre>
        </div>
    );
}
