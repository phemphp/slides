<?phem

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\{Html, Node};

#[Component]
function StepMarker(Html $children, bool $small = false, string $tone = '', string $className = ''): Node
{
    $classes = ['ph-step', $small ? 'ph-step-sm' : '', $tone ? 'is-'.$tone : '', $className];

    return <span className={{ classes }}>{{ children }}</span>;
}
