<?phpm

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\{Html, Node};

// A numbered disc that ties a line of code, a note and a part of a diagram together.
// `tone`: cool (the second track) or muted (not explained yet).
#[Component]
function StepMarker(Html $children, bool $small = false, string $tone = ''): Node
{
    $classes = ['ph-step', $small ? 'ph-step-sm' : '', $tone ? 'is-'.$tone : ''];

    return <span className={{ classes }}>{{ children }}</span>;
}
