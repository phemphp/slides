<?phpm

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function DeckNav(
    int $number,
    int $total,
    Closure $onFirst,
    Closure $onPrevious,
    Closure $onNext,
): Node {
    return (
        <nav className="absolute right-4 bottom-4 flex items-center gap-2 text-sm text-(--text-tertiary) opacity-30 transition-opacity hover:opacity-100">
            <button type="button" onClick={{ onFirst }} data-deck-keys-target="first" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="First slide (Home)">⇤</button>
            <button type="button" onClick={{ onPrevious }} data-deck-keys-target="previous" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="Previous (←)">←</button>
            <span className="tabular-nums">{{ number }} / {{ total }}</span>
            <button type="button" onClick={{ onNext }} data-deck-keys-target="next" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="Next (→)">→</button>
        </nav>
    );
}
