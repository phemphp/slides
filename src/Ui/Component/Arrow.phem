<?phem

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function Arrow(
    string $label = '',
    string $tone = '',
    bool $back = false,
    bool $dashed = false,
    bool $down = false,
    ?string $curve = null,
    int $width = 260,
    int $height = 150,
    string $className = '',
    ?string $style = null,
): Node {
    $toneClass = $tone ? 'is-'.$tone : '';

    if (null !== $curve) {
        $classes = ['ph-arrow-svg', $toneClass, $dashed ? 'is-dashed' : '', $className];
        $viewBox = sprintf('0 0 %d %d', $width, $height);
        // The same curve and tone draw the same head: the id can repeat.
        $head = 'ph-head-'.substr(md5($curve.$toneClass), 0, 8);
        $markerEnd = sprintf('url(#%s)', $head);

        return (
            <svg className={{ classes }} style={{ style }} width={{ width }} height={{ height }} viewBox={{ viewBox }} aria-hidden="true">
                <defs>
                    <marker id={{ head }} viewBox="0 0 16 16" refX="13" refY="8" markerWidth="16" markerHeight="16" markerUnits="userSpaceOnUse" orient="auto">
                        <path className="ph-arrow-head" d="M3 2 L13 8 L3 14" />
                    </marker>
                </defs>
                <path className="ph-arrow-path" d={{ curve }} marker-end={{ markerEnd }} />
            </svg>
        );
    }

    $classes = ['ph-arrow', $toneClass, $back ? 'is-back' : '', $dashed ? 'is-dashed' : '', $down ? 'is-down' : '', $className];

    return (
        <span className={{ classes }} style={{ style }}>
            {% if down %}
                <span className="ph-arrow-line"></span>
                {% if label %}<span className="ph-arrow-label">{{ label }}</span>{% endif %}
            {% else %}
                {% if label %}<span className="ph-arrow-label">{{ label }}</span>{% endif %}
                <span className="ph-arrow-line"></span>
            {% endif %}
        </span>
    );
}
