<?phem

namespace App\Ui\Component;

use App\Deck\Step;
use Phem\Attribute\{Component, Context};
use Phem\{Html, Node};

#[Component]
function Slide(
    Html $children,
    string $glowX = '30%',
    string $glowY = '45%',
    ?string $footer = null,
    ?string $number = null,
    string $className = '',
    int $steps = 0,
    #[Context] ?Step $step = null,
): Node {
    $classes = ['ph-slide ph-frame-content', $className];
    $style = sprintf('--glow-x: %s; --glow-y: %s;', $glowX, $glowY);
    $stepCount = $steps > 0 ? $steps : null;
    $current = $steps > 0 ? min($step?->current ?? 1, $steps) : null;

    return (
        <div className="ph-frame">
            <section className={{ classes }} style={{ style }} data-deck-steps={{ stepCount }} data-deck-step={{ current }}>
                {{ children }}
                {% if footer or number %}
                    <div className="ph-footer">{% if footer %}<span>{{ footer }}</span>{% endif %}{% if number %}<span>{{ number }}</span>{% endif %}</div>
                {% endif %}
            </section>
        </div>
    );
}
