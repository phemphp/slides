<?phem

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\{Html, Node};

#[Component]
function FlowSlide(Html $title, Html $children, ?Html $back = null, string $eyebrow = '', ?string $footer = null, ?string $number = null): Node
{
    return (
        <Slide glowX="50%" glowY="58%" footer={{ footer }} number={{ number }}>
            <SlideHeading eyebrow={{ eyebrow }}>{{ title }}</SlideHeading>
            <div className="ph-flow mt-20">{{ children }}</div>
            {% if back %}<div className="mt-9 flex justify-center">{{ back }}</div>{% endif %}
        </Slide>
    );
}
