<?phpm

namespace App\Ui\Component;

use App\Deck\Role;
use App\Repository\PresentationRepository;
use App\Security\SpeakerAccess;
use App\Ui\Slide\Slides;
use Phem\Attribute\{Component, Prop, Provide, Broadcast};
use Phem\Node;
use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;

// The current slide of the presentation. The speaker moves it: the other screens follow.
// A dynamic slide reads the role (#[Context] Role) to show the speaker or the audience part.
// #[Broadcast]: after each move, the other pages that render the deck render it again.
#[Component, Broadcast]
final class Deck
{
    #[Prop, Provide] 
    public Role $role = Role::Audience;

    private int $index = 0;
    private int $total = 0;
    private ?Node $slide = null;

    /** @var list<Node> */
    private array $slides;

    public function __construct(
        private readonly PresentationRepository $presentation,
        private readonly SpeakerAccess $speakerAccess,
    ) {
        $this->slides = new Slides()->all();
    }

    // No #[State]: each render reads the current slide again (also after a push).
    public function mount(): void
    {
        $this->load($this->presentation->get()->slide);
    }

    public function next(): void
    {
        $this->move($this->index + 1);
    }

    public function previous(): void
    {
        $this->move($this->index - 1);
    }

    public function first(): void
    {
        $this->move(0);
    }

    public function render(): Node
    {
        $speaker = Role::Speaker === $this->role;
        $slide = $this->slide;
        $number = $this->index + 1;
        $total = $this->total;

        return (
            <section
                id="deck"
                className={{ speaker ? 'relative flex h-full flex-col overflow-hidden' : 'ph-deck-audience' }}
                data-controller={{ speaker ? 'deck-keys' : null }}
                data-action={{ speaker ? 'keydown@window->deck-keys#press' : null }}
                data-phem-transition
            >
                <div className="ph-deck-stage">
                    <div>{{ slide }}</div>
                </div>
                {% if speaker %}
                    <DeckNav number={{ number }} total={{ total }} onFirst={{ first }} onPrevious={{ previous }} onNext={{ next }} />
                {% endif %}
            </section>
        );
    }

    private function move(int $index): void
    {
        if (Role::Speaker !== $this->role || !$this->speakerAccess->granted()) {
            throw new AccessDeniedHttpException('Only the speaker moves the slides.');
        }

        $presentation = $this->presentation->get();
        $presentation->slide = $this->clamp($index);
        $this->presentation->save($presentation);

        $this->load($presentation->slide);
    }

    private function load(int $index): void
    {
        $this->index = $this->clamp($index);
        $this->total = \count($this->slides);
        $this->slide = $this->slides[$this->index] ?? null;
    }

    private function clamp(int $index): int
    {
        return max(0, min($index, \count($this->slides) - 1));
    }
}
