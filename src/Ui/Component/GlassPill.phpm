<?phpm

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\Node;

#[Component]
function GlassPill(string $label, string $icon, bool $active = false, bool $small = false, string $className = ''): Node
{
    $classes = ['ph-pill', $small ? 'ph-pill-sm' : '', $className];
    $size = $small ? 'sm' : 'md';

    return (
        <div className={{ classes }}>
            <IconOrb icon={{ icon }} size={{ size }} active={{ active }} />
            <span className="ph-pill-label">{{ label }}</span>
        </div>
    );
}
