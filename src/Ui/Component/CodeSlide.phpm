<?phpm

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\{Html, Node};

#[Component]
function CodeSlide(Html $title, Html $children, ?Html $notes = null, string $eyebrow = '', ?string $footer = null, ?string $number = null): Node
{
    $columns = $notes ? 'grid-cols-[1fr_300px]' : 'grid-cols-1';

    return (
        <Slide glowX="82%" glowY="12%" footer={{ footer }} number={{ number }} className="pt-16">
            <SlideHeading eyebrow={{ eyebrow }} className="text-[52px]">{{ title }}</SlideHeading>
            <div className={{ ['mt-9 grid items-start gap-8', columns] }}>
                {{ children }}
                {% if notes %}<div className="grid gap-4 pt-6">{{ notes }}</div>{% endif %}
            </div>
        </Slide>
    );
}
