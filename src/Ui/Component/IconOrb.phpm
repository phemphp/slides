<?phpm

namespace App\Ui\Component;

use Phem\Attribute\Component;
use Phem\Node;

// A metal icon (or a number) on a sunken disc inside a ring. Sizes: sm, md, lg. Only one orb on
// a slide is active: it gets the iridescent ring and the warm glow.
#[Component]
function IconOrb(string $icon = '', string $size = 'md', bool $active = false, ?string $number = null, string $className = ''): Node
{
    $classes = ['ph-orb', 'md' === $size ? '' : 'ph-orb-'.$size, $active ? 'is-active' : '', $className];
    $iconClass = 'ph-icon ph-icon-'.$icon;

    return (
        <span className={{ classes }}>
            <span className="ph-orb-ring"></span>
            <span className="ph-orb-disc"></span>
            {% if number is not null %}
                <span className="ph-orb-num">{{ number }}</span>
            {% else %}
                <span className={{ iconClass }}></span>
            {% endif %}
        </span>
    );
}
