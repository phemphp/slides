<?phem

namespace App\Ui\Component;

use App\Deck\Role;
use App\Entity\Presentation;
use App\Security\SpeakerAccess;
use Phem\Attribute\{Component, Context, Prop, Transactional};
use Phem\Event;
use Phem\Node;
use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;

#[Component, Transactional]
final class DeckNav
{
    #[Prop] public Presentation $presentation;
    #[Prop] public int $number;
    #[Prop] public int $total;
    #[Context] public Role $role;

    public function __construct(
        private readonly SpeakerAccess $speakerAccess,
    ) {
    }

    public function move(int $index, Event $e): void
    {
        $this->update(function (Presentation $presentation) use ($index) {
            $presentation->slide = max(0, min($index, $this->total - 1));
            // A slide starts at its first point.
            $presentation->step = 1;
        }, $e);
    }

    public function point(int $by, Event $e): void
    {
        $this->update(fn (Presentation $presentation) => $presentation->step = max(1, $presentation->step + $by), $e);
    }

    public function render(): Node
    {
        return (
            <nav
                className="absolute right-4 bottom-4 flex items-center gap-2 text-sm text-(--text-tertiary) opacity-30 transition-opacity hover:opacity-100"
                data-controller="deck-keys"
                data-action="keydown@window->deck-keys#press"
            >
                <button type="button" onClick={{ move(0) }} data-deck-keys-target="first" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="First slide (Home)">⇤</button>
                <button type="button" onClick={{ move(number - 2) }} data-deck-keys-target="previous" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="Previous (←)">←</button>
                <span className="tabular-nums">{{ number }} / {{ total }}</span>
                <button type="button" onClick={{ point(-1) }} data-deck-keys-target="up" tabindex="-1" hidden>↑</button>
                <button type="button" onClick={{ point(1) }} data-deck-keys-target="down" tabindex="-1" hidden>↓</button>
                <button type="button" onClick={{ move(number) }} data-deck-keys-target="next" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="Next (→)">→</button>
            </nav>
        );
    }

    private function update(\Closure $change, Event $e): void
    {
        if (Role::Speaker !== $this->role || !$this->speakerAccess->granted()) {
            throw new AccessDeniedHttpException('Only the speaker moves the slides.');
        }

        // #[Transactional] flushes the change when the handler returns.
        $change($this->presentation);

        // The deck reads the new slide and point in mount(). The other browsers get the
        // broadcast of the Presentation (see Deck).
        $e->refresh();
    }
}
