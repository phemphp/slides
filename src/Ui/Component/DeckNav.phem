<?phem

namespace App\Ui\Component;

use App\Entity\Presentation;
use Phem\Attribute\{Component, Prop, Transactional};
use Phem\Node;
use Phem\Reply;

#[Component]
final class DeckNav
{
    #[Prop] public Presentation $presentation;
    #[Prop] public int $number;
    #[Prop] public int $total;

    #[Transactional]
    public function move(int $index, Reply $reply): void
    {
        $this->presentation->slide = max(0, min($index, $this->total - 1));

        // The deck reads the new slide in mount().
        $reply->refresh();
    }

    public function render(): Node
    {
        return (
            <nav
                className="absolute right-4 bottom-4 flex items-center gap-2 text-sm text-(--text-tertiary) opacity-30 transition-opacity hover:opacity-100"
                data-controller="deck-keys"
                data-action="keydown@window->deck-keys#press"
            >
                <button type="button" onClick={{ move(0) }} data-deck-keys-target="first" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="First slide (Home)">⇤</button>
                <button type="button" onClick={{ move(number - 2) }} data-deck-keys-target="previous" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="Previous (←)">←</button>
                <span className="tabular-nums">{{ number }} / {{ total }}</span>
                <button type="button" onClick={{ move(number) }} data-deck-keys-target="next" tabindex="-1" className="rounded px-2 py-1 hover:bg-(--surface-raised)" title="Next (→)">→</button>
            </nav>
        );
    }
}
