<?phem

namespace App\Ui\Layout;

use App\Ui\Component\SlideHeading;
use Phem\Attribute\Component;
use Phem\{Html, Node};

#[Component]
function FlowSlide(Html $title, Html $children, ?Html $back = null, string $eyebrow = '', string $titleClassName = '', ?string $footer = null, ?string $number = null, ?Html $speakerNotes = null): Node
{
    return (
        <Slide glowX="50%" glowY="50%" footer={{ footer }} number={{ number }} speakerNotes={{ speakerNotes }}>
            <SlideHeading eyebrow={{ eyebrow }} className={{ titleClassName }}>{{ title }}</SlideHeading>
            <div className="ph-flow mt-10">{{ children }}</div>
            {% if back %}<div className="mt-9 flex justify-center">{{ back }}</div>{% endif %}
        </Slide>
    );
}
