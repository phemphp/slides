<?phem

namespace App\Ui\Layout;

use App\Ui\Component\SlideHeading;
use Phem\Attribute\Component;
use Phem\{Html, Node};

#[Component]
function BulletSlide(Html $title, Html $children, string $eyebrow = '', ?string $footer = null, ?string $number = null, ?Html $speakerNotes = null): Node
{
    return (
        <Slide glowX="16%" glowY="48%" footer={{ footer }} number={{ number }} speakerNotes={{ speakerNotes }}>
            <SlideHeading eyebrow={{ eyebrow }} className="mb-9">{{ title }}</SlideHeading>
            <ul className="ph-list max-w-[760px]">{{ children }}</ul>
        </Slide>
    );
}
