{
	frankenphp {
		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}

{$SERVER_NAME::8080} {
	encode zstd gzip

	# The deck shows the debug toolbar of Symfony (/_wdt) to all, also through the tunnel: it is a
	# part of the slides. The profiler behind it (the details of each request, phpinfo, the file
	# viewer) is only for a browser on this machine. The Host header is safe for this check,
	# because compose.yaml publishes the port to this machine only, and the tunnel does not accept
	# a false Host header.
	@profiler {
		path /_profiler* /_error*
		not host localhost 127.0.0.1 ::1
	}
	respond @profiler 404

	# The hub of the #[Broadcast] updates. The updates are public (no subscriber key): they only
	# tell a browser to render a component again, and a public update needs no Secure cookie, so
	# it also reaches a phone on plain HTTP.
	mercure {
		name phem
		transport local
		anonymous
	}

	root * public
	php_server
}
